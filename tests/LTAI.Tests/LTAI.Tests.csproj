<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsExeProject>true</IsExeProject>
    <PublishSingleFile>false</PublishSingleFile>
    <RootNamespace>LTAI.Tests</RootNamespace>
    <OutputPath>bin/Debug/net10.0/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" VersionOverride="17.13.0" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" VersionOverride="3.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Agents.AI" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.dll')" />
    <Reference Include="Microsoft.Agents.AI.Abstractions" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Abstractions.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Abstractions.dll')" />
    <Reference Include="Microsoft.Agents.AI.Hosting" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.dll')" />
    <Reference Include="Microsoft.Agents.AI.Workflows" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Workflows.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Workflows.dll')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- A2A tests excluded: requires Microsoft.Agents.AI.Hosting.A2A NuGet/assembly not available in this project -->
  <ItemGroup>
    <Compile Remove="A2A\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Agents.AI.Hosting.A2A.AspNetCore" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.A2A.AspNetCore.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.A2A.AspNetCore.dll')" />
    <Reference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.AGUI.AspNetCore.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.AGUI.AspNetCore.dll')" />
    <Reference Include="Microsoft.Agents.AI.Mcp" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Mcp.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Mcp.dll')" />
  </ItemGroup>



  <ItemGroup>
    <ProjectReference Include="..\..\src\LTAI.Core\LTAI.Core.csproj" />
    <ProjectReference Include="..\..\src\LTAI.AI\LTAI.AI.csproj" />
    <ProjectReference Include="..\..\src\LTAI.Agent\LTAI.Agent.csproj" />
    <ProjectReference Include="..\..\src\LTAI.Agent.CodeAnalysis\LTAI.Agent.CodeAnalysis.csproj" />
    <ProjectReference Include="..\..\src\LTAI.Cli\LTAI.Cli.csproj" />
    <ProjectReference Include="..\..\src\LTAI.TUI\LTAI.TUI.csproj" />
    <PackageReference Include="Spectre.Console.Testing" />
  </ItemGroup>

</Project>
