# =============================================================================
# LTAI 4 Net — Environment Variables Template
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# =============================================================================
# 只需配置一个可用的 LLM API Key 即可启动（推荐 DEEPSEEK）

# ── LLM Provider API Keys（至少配置其中一个） ──────────────────────────────
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# SILICONFLOW_API_KEY=sf-your-key
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# ZHIPU_API_KEY=your-zhipu-key
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-key
# OPENROUTER_API_KEY=sk-or-v1-your-key
# GROQ_API_KEY=gsk-your-key
# BAIDU_API_KEY=your-baidu-key
# HUNYUAN_API_KEY=your-hunyuan-key
# MOONSHOT_API_KEY=your-moonshot-key
# BAICHUAN_API_KEY=your-baichuan-key

# ── Service API Keys（可选） ──────────────────────────────────────────────
# BRAVE_API_KEY=          # Brave Search（默认 Web 搜索）
# SERPER_API_KEY=         # Serper Google 搜索（fallback）
# AMAP_KEY=               # 高德地图 API
# TENCENT_MAP_KEY=        # 腾讯地图 API
# BAIDU_MAP_KEY=          # 百度地图 API
# WEATHER_KEY=            # 和风天气 API
# BAIDU_TRANSLATE_APPID=  # 百度翻译 APP ID
# BAIDU_TRANSLATE_SECRET= # 百度翻译 Secret
# UNSPLASH_KEY=           # Unsplash 图片搜索
# MEM0_API_KEY=           # Mem0 跨会话长期记忆

# ── LTAI 通用配置 ─────────────────────────────────────────────────────────
LTAI_DATA_DIR=.livingtree
# LTAI_DEFAULT_PROVIDER=deepseek-fast  # 覆盖自动选拔的默认 Provider
# LTAI_L1_MODEL=                       # 覆盖 L1（fast）模型
# LTAI_L2_MODEL=                       # 覆盖 L2（pro）模型
# LTAI_L3_MODEL=                       # 覆盖 L3（judge）模型
LTAI_API_KEY=                          # Web API 鉴权密钥

# ── 并发控制（默认值） ────────────────────────────────────────────────────
# LTAI_SHELL_CONCURRENCY=8
# LTAI_WASM_CONCURRENCY=6
# LTAI_MOA_CONCURRENCY=6
# LTAI_WORKFLOW_CONCURRENCY=6
# LTAI_JOB_MAX_CONCURRENT=10
# LTAI_SEARCH_MAX_DOP=4
# LTAI_TASK_QUEUE_MAX=100000

# ── 超时控制 ──────────────────────────────────────────────────────────────
# LTAI_SHELL_TIMEOUT_SEC=30
# LTAI_WASM_TIMEOUT_SEC=60
# LTAI_SCRIPT_TIMEOUT_SEC=60
# LTAI_JOB_PROCESS_TIMEOUT_SEC=300
# LTAI_REGEX_TIMEOUT_MS=1000
# LTAI_SQLITE_BUSY_MS=5000

# ── 缓存与间隔 ────────────────────────────────────────────────────────────
# LTAI_LLM_CACHE_TTL_MIN=5
# LTAI_COMPRESSION_MAX_AGE_DAYS=30
# LTAI_CG_CACHE_SIZE=100
# LTAI_CG_CACHE_TTL_SEC=30
# LTAI_MEMORY_CONSOLIDATION_MINUTES=30

# ── Web 速率限制 ──────────────────────────────────────────────────────────
# LTAI_RATE_LIMIT_REQUESTS=60
# LTAI_RATE_LIMIT_WINDOW_SEC=60

# ── 遥测 ─────────────────────────────────────────────────────────────────
# LTAI_OTLP_ENDPOINT=http://jaeger:4317

# ── Docker / ASP.NET ────────────────────────────────────────────────────
# ASPNETCORE_URLS=http://+:5100
# ASPNETCORE_ENVIRONMENT=Production
