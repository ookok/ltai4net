{
  "$schema": "http://json.schemastore.org/template",
  "author": "LTAI Team",
  "classifications": ["LTAI", "Agent"],
  "identity": "LTAI.Agent.Template",
  "name": "LTAI Agent",
  "shortName": "ltai-agent",
  "description": "Generate a new LTAI v7.0 Agent with strategy pattern, YAML config, and tests skeleton.",
  "sourceName": "AgentTemplate",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "symbols": {
    "AgentName": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "AgentTemplate",
      "defaultValue": "MyAgent",
      "description": "The name of the agent class"
    },
    "AgentType": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "code_agent", "description": "Code analysis and generation agent" },
        { "choice": "eia_agent", "description": "Environmental Impact Assessment agent" },
        { "choice": "reasoning_agent", "description": "MCTS deep reasoning agent" },
        { "choice": "chat_agent", "description": "General conversational agent" }
      ],
      "defaultValue": "chat_agent",
      "description": "The agent type"
    },
    "AgentDescription": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "Custom LTAI v7.0 Agent",
      "description": "Short description of the agent"
    }
  }
}
