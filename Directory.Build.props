<Project>
  <PropertyGroup>
    <NoWarn>$(NoWarn);MSB3243;NU1510;MAAIW001</NoWarn>
    <!-- Chinese-only: exclude satellite resources for other locales, save ~10MB per output -->
    <SatelliteResourceLanguages>zh-Hans;zh-Hant</SatelliteResourceLanguages>

    <Optimize>true</Optimize>
    <DebugType>embedded</DebugType>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <ModuleSkipLocalsInit>true</ModuleSkipLocalsInit>
  </PropertyGroup>

  <!-- All library projects output to dist/lib for shared DLLs -->
  <PropertyGroup Condition="'$(IsExeProject)' != 'true' And '$(IsTestProject)' != 'true'">
    <OutputPath>$(MSBuildThisFileDirectory)dist\lib\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
</Project>
