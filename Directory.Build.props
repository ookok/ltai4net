<Project>
  <PropertyGroup>
    <NoWarn>$(NoWarn);MSB3243;NU1510;MAAIW001;IL2026;IL3050;IL2046;IL2091;IL2104</NoWarn>
    <!-- Chinese-only: exclude satellite resources for other locales, save ~10MB per output -->
    <SatelliteResourceLanguages>zh-Hans;zh-Hant</SatelliteResourceLanguages>

    <Optimize>true</Optimize>
    <DebugType>embedded</DebugType>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>

    <!-- 跳过 extern 项目重编译（~64s → ~7s）。extern 更新后用 -p:BuildProjectReferences=true 全量构建一次即可。 -->
    <BuildProjectReferences>false</BuildProjectReferences>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <ModuleSkipLocalsInit>true</ModuleSkipLocalsInit>
  </PropertyGroup>

  <!-- All library projects output to dist/lib for shared DLLs -->
  <PropertyGroup Condition="'$(IsExeProject)' != 'true' And '$(IsTestProject)' != 'true'">
    <OutputPath>$(MSBuildThisFileDirectory)dist\lib\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- Copy runtime data (agents, models, skills, tools) to exe build/publish output -->
  <ItemGroup Condition="'$(IsExeProject)' == 'true'">
    <Content Include="$(MSBuildThisFileDirectory)agents\**\*" CopyToOutputDirectory="PreserveNewest" Link="agents\%(RecursiveDir)%(FileName)%(Extension)" />
    <Content Include="$(MSBuildThisFileDirectory)models\**\*" CopyToOutputDirectory="PreserveNewest" Link="models\%(RecursiveDir)%(FileName)%(Extension)" Condition="Exists('$(MSBuildThisFileDirectory)models')" />
    <Content Include="$(MSBuildThisFileDirectory)skills\**\*" CopyToOutputDirectory="PreserveNewest" Link="skills\%(RecursiveDir)%(FileName)%(Extension)" />
    <Content Include="$(MSBuildThisFileDirectory)tools\rg\rg.exe" CopyToOutputDirectory="PreserveNewest" Link="tools\rg\rg.exe" Condition="Exists('$(MSBuildThisFileDirectory)tools\rg\rg.exe')" />
  </ItemGroup>
</Project>
