<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);MSB3243;NU1510;MAAIW001;IL2026;IL3050</NoWarn>
    <!-- Chinese-only: exclude satellite resources for other locales, save ~10MB per output -->
    <SatelliteResourceLanguages>zh-Hans,zh-Hant</SatelliteResourceLanguages>

    <Optimize>true</Optimize>
    <DebugType>embedded</DebugType>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>

    <!-- Build project references by default. For faster incremental dev builds, use -p:BuildProjectReferences=false -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <ModuleSkipLocalsInit>true</ModuleSkipLocalsInit>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)src\Shared\Polyfill.cs" Link="Shared\Polyfill.cs" />
  </ItemGroup>

  <!-- All library projects output to dist/lib for shared DLLs -->
  <PropertyGroup Condition="'$(IsExeProject)' != 'true' And '$(IsTestProject)' != 'true'">
    <OutputPath>$(MSBuildThisFileDirectory)dist\lib\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- Copy runtime data (agents, models, skills, tools, config) to exe build/publish output -->
  <ItemGroup Condition="'$(IsExeProject)' == 'true'">
    <Content Include="$(MSBuildThisFileDirectory)agents\**\*" CopyToOutputDirectory="PreserveNewest" Link="agents\%(RecursiveDir)%(FileName)%(Extension)" />
    <Content Include="$(MSBuildThisFileDirectory)models\**\*" CopyToOutputDirectory="PreserveNewest" Link="models\%(RecursiveDir)%(FileName)%(Extension)" Condition="Exists('$(MSBuildThisFileDirectory)models')" />
    <Content Include="$(MSBuildThisFileDirectory)skills\**\*" CopyToOutputDirectory="PreserveNewest" Link="skills\%(RecursiveDir)%(FileName)%(Extension)" />
    <Content Include="$(MSBuildThisFileDirectory)tools\rg\rg.exe" CopyToOutputDirectory="PreserveNewest" Link="tools\rg\rg.exe" Condition="Exists('$(MSBuildThisFileDirectory)tools\rg\rg.exe')" />
    <!-- Canonical config: root appsettings.json is the single source of truth for all exe projects -->
    <Content Include="$(MSBuildThisFileDirectory)appsettings.json" CopyToOutputDirectory="PreserveNewest" Link="appsettings.json" Condition="Exists('$(MSBuildThisFileDirectory)appsettings.json')" />
  </ItemGroup>
</Project>
