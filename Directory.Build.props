<Project>
  <PropertyGroup>
    <NoWarn>$(NoWarn);MSB3243;NU1510;MAAIW001</NoWarn>
  </PropertyGroup>

  <!-- All projects output to dist/lib for shared DLLs (debug builds) -->
  <PropertyGroup Condition="'$(IsExeProject)' != 'true'">
    <OutputPath>$(MSBuildThisFileDirectory)dist\lib\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- Exe projects: build → dist/ -->
  <PropertyGroup Condition="'$(IsExeProject)' == 'true'">
    <OutputPath>$(MSBuildThisFileDirectory)dist\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- After publish: copy self-contained EXE to dist/ root -->
  <Target Name="CopyExeToDistRoot" AfterTargets="Publish" Condition="'$(IsExeProject)' == 'true'">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe"
          DestinationFolder="$(MSBuildThisFileDirectory)dist\"
          SkipUnchangedFiles="true" />
    <Message Text="  → dist/$(AssemblyName).exe" Importance="high" />
  </Target>
</Project>
