{
  "LTAI": {
    "AI": {
      "DefaultProvider": "deepseek-fast",
      "ContextWindowSize": 64000,
      "MaxTokens": 4096,
      "Temperature": 0.7,
      "SkipSafetyChecks": false,
      "L1": {
        "Provider": "deepseek-fast",
        "Model": "deepseek-v4-flash"
      },
      "AutoSelect": {
        "Enabled": true,
        "RefreshIntervalMin": 30,
        "MinScoreImprovement": 0.15
      }
    },
    "Embedding": {
      "Gpu": "auto",
      "Quantization": "int8",
      "PreWarmAllModels": false
    },
    "Mirrors": {
      "ModelBaseUrl": "https://hf-mirror.com/",
      "WarpMsiUrl": "https://github.com/cloudflare/cloudflare-warp/releases/download/2026.4.1390.0/Cloudflare_WARP_2026.4.1390.0.msi",
      "WindowsTerminalUrl": "https://github.com/microsoft/terminal/releases/download/v1.24.11321.0/Microsoft.WindowsTerminal_1.24.11321.0_x64.zip",
      "RipGrepUrl": "https://github.com/BurntSushi/ripgrep/releases/download/14.1.1/rg.exe"
    },
    "Environment": {},
    "Security": {
      "SystemPathFallback": "C:\\Windows\\system32;C:\\Windows",
      "BlockedExes": [
        "sudo","su","chmod","chown","mkfs","fdisk","dd","shutdown","reboot",
        "init","halt","poweroff","passwd","useradd","usermod","groupadd",
        "fuser","kill","mount","umount","iptables","ufw","systemctl",
        "cmd","cmd.exe","certutil","bitsadmin","mshta","cscript","wmic",
        "reg","schtasks","diskpart","bcdedit","regsvr32","rundll32",
        "attrib","cacls","takeown","icacls","vssadmin"
      ],
      "DangerousPatterns": [
        "rm -rf /","rm -rf ~","rm -rf --no-preserve-root",
        ":(){ :|:& };:","eval ","exec ",
        "> /dev/","dd if=","wget -O - | sh","curl .* | sh",
        "wget .* -O ","certutil .* -urlcache","bitsadmin .* /transfer"
      ],
      "ProtectedPaths": [
        "/etc","/sys","/proc","/dev","/boot",
        "/var/log","/var/lib","/var/spool",
        "C:\\Windows","C:\\Windows\\System32",
        "C:\\Program Files","C:\\Program Files (x86)","C:\\ProgramData"
      ],
      "CodeExecNames": [
        "bash","sh","zsh","dash","ksh","fish",
        "python","python2","python3","py",
        "perl","perl5","ruby","rake","php",
        "lua","luajit","tclsh","wish",
        "powershell","pwsh","powershell.exe","pwsh.exe"
      ],
      "CodeExecArgs": ["-c","-command","-e","-i"],
      "CommandSeps": ["&&","||","|","&",";"],
      "PlatformUnsupportedWarnings": {
        "chmod": "Windows 使用 ACL 而非 POSIX 权限位。考虑使用 icacls。",
        "chown": "Windows 使用 ACL 而非 POSIX 权限位。考虑使用 icacls。",
        "chgrp": "Windows 使用 ACL 而非 POSIX 权限位。考虑使用 icacls。",
        "chroot": "Windows 无 chroot 等效机制。",
        "mkfifo": "Windows 不支持命名管道设备节点。",
        "mknod": "Windows 不支持设备节点。",
        "kill": "Windows 无 POSIX 信号机制。使用 taskkill /F /PID <id>。",
        "nohup": "Windows 无 nohup 等效。",
        "nice": "Windows 无进程优先级命令。",
        "ln": "Windows 无符号链接。考虑 mklink。",
        "id": "Windows 使用不同的用户管理 API。尝试 whoami。",
        "groups": "Windows 使用不同的用户管理 API。",
        "who": "Windows 使用不同的用户管理 API。",
        "logname": "Windows 使用不同的用户管理 API。",
        "sync": "Windows 自动同步文件系统缓存。",
        "shred": "Windows 无安全删除命令。",
        "stty": "Windows 无终端设置命令。",
        "tty": "Windows 无终端名称命令。"
      },
      "PowerShellAliasConflicts": {
        "ls": "ls.exe","cat": "cat.exe","cp": "cp.exe",
        "mv": "mv.exe","rm": "rm.exe","pwd": "pwd.exe",
        "sort": "sort.exe","tee": "tee.exe","uptime": "uptime.exe",
        "mkdir": "mkdir.exe","rmdir": "rmdir.exe","sleep": "sleep.exe"
      },
      "ShellConcurrency": 8
    }
  }
}
