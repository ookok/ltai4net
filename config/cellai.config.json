{
  "CellAI": {
    "HybridStrategy": {
      "SelfTrainedOverrideThreshold": 0.75,
      "FallbackToSelfTrained": true
    },
    "PretrainedModels": {
      "AutoDownload": true,
      "ModelsDirectory": "synaptic/pretrained",
      "Models": {
        "code": {
          "Source": "context4ai/intent-router-onnx",
          "Description": "Code intent classification (EN/ZH)",
          "MinConfidence": 0.5,
          "Labels": [
            "locate_symbol",
            "find_references",
            "trace_dependencies",
            "semantic_search",
            "browse_structure",
            "cross_layer_trace",
            "ambiguous"
          ]
        },
        "greeting": {
          "Source": "tanaos/tanaos-intent-classifier-v1",
          "Description": "Chatbot intent classification",
          "MinConfidence": 0.6,
          "Labels": [
            "greeting",
            "farewell",
            "thank_you",
            "affirmation",
            "negation",
            "small_talk",
            "bot_capabilities",
            "feedback_positive",
            "feedback_negative",
            "clarification",
            "suggestion",
            "language_change"
          ]
        },
        "general": {
          "Source": "RunsOnBacon/distilbert-intent-classifier-onnx-int8",
          "Description": "General intent classification (INT8 quantized)",
          "MinConfidence": 0.5,
          "Labels": [
            "arithmetic",
            "symbolic_reasoning",
            "factual_lookup",
            "creative_synthesis",
            "code_generation",
            "security_risk"
          ]
        }
      }
