<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LTAI.Accelerator.MainWindow"
        Title="LTAI 加速器"
        Icon="/Assets/ltai-icon.ico"
        Width="420" Height="440"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#1a1a2e">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="24">

    <!-- Header: icon + title -->
    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,16">
      <TextBlock Text="⚡" FontSize="32" HorizontalAlignment="Center" Foreground="#4fc3f7"/>
      <TextBlock Text="LTAI 网络加速器" FontSize="20" FontWeight="Bold"
                 HorizontalAlignment="Center" Foreground="#e0e0e0"/>
      <TextBlock Text="安全 · 快速 · 零配置" FontSize="11"
                 HorizontalAlignment="Center" Foreground="#888"/>
    </StackPanel>

    <!-- Status card -->
    <Border Grid.Row="1" CornerRadius="12" Padding="16,14"
            Background="#16213e" BorderBrush="#0f3460" BorderThickness="1">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
        <!-- Status dot -->
        <Ellipse Name="StatusDot" Width="12" Height="12" Fill="#666"
                 Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock Name="StatusText" Text="准备就绪" FontSize="14" FontWeight="SemiBold"
                   Foreground="#ccc" Grid.Row="0" Grid.Column="1"/>
        <TextBlock Name="DohInfo" Text="DNS: 1.1.1.1 (DoH) ✓ 防污染" FontSize="11"
                   Foreground="#aaa" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"/>
        <TextBlock Name="ProxyInfo" Text="http://127.0.0.1:11818" FontSize="11"
                   Foreground="#555" Grid.Row="2" Grid.Column="1" Margin="0,2,0,0"
                   Cursor="Hand" PointerPressed="OnProxyClick"/>
      </Grid>
    </Border>

    <!-- WARP info + install -->
    <StackPanel Grid.Row="2" Margin="0,12,0,0" VerticalAlignment="Top" Spacing="6">
      <Border CornerRadius="8" Padding="10,8"
              Background="#1a1a2e" BorderBrush="#0f3460" BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Cloudflare WARP" FontSize="13" FontWeight="SemiBold" Foreground="#ccc"/>
            <TextBlock Name="WarpInfo" Text="检测中..." FontSize="11" Foreground="#777"/>
          </StackPanel>
          <Button Name="BtnInstallWarp" Content="+ 安装"
                  FontSize="12" Height="28" Padding="12,0" IsVisible="False"
                  VerticalAlignment="Center" HorizontalAlignment="Right"
                  Grid.Column="1" Click="OnInstallWarpClick"
                  Background="#1a73e8" Foreground="White" BorderThickness="0"
                  CornerRadius="6"/>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Action buttons -->
    <StackPanel Grid.Row="3" Margin="0,24,0,20" Spacing="10"
                HorizontalAlignment="Center">
      <Button Name="BtnStart" Content="▶ 开始加速" Width="220" Height="46"
              FontSize="16" Click="OnStartClick"
              Background="#1a73e8" Foreground="White" BorderThickness="0"
              CornerRadius="23"/>
      <Button Name="BtnStop" Content="■ 停止加速" Width="220" Height="46"
              FontSize="16" Click="OnStopClick"
              Background="#c62828" Foreground="White"
              BorderThickness="0" CornerRadius="23" IsEnabled="False"/>
    </StackPanel>
  </Grid>
</Window>
