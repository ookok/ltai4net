{
  "LTAI": {
    "data_directory": ".livingtree",
    "AI": {
      "onnx_enabled": true,
      "default_provider": "deepseek",
      "l0": {
        "provider": "local",
        "model": "bge-large-zh-v1.5-onnx",
        "dimension": 1536,
        "comment": "L0 embedding: aliyun text-embedding-v1 (1536d, verified). L1/L2 via DeepSeek v4-pro/v4-flash"
      },
      "l1": {
        "provider": "deepseek",
        "model": "deepseek-v4-flash",
        "temperature": 0.3,
        "comment": "L1 fast: deepseek-v4-flash (1M ctx, 384K out, 1/2 RMB per 1M in/out). Thinking模式默认开启"
      },
      "l2": {
        "provider": "deepseek",
        "model": "deepseek-v4-pro",
        "temperature": 0.3,
        "comment": "L2 deep: deepseek-v4-pro (1M ctx, 384K out, 3/6 RMB per 1M in/out). 高难度推理+EIA+代码分析"
      },
      "daily_budget_usd": 10.0,
      "default_temperature": 0.3,
      "max_tokens": 4096,
      "timeout_ms": 120000,
      "max_collaboration_rounds": 5,
      "system_prompts": {
        "investigate_before_answering": "Never speculate about content you haven't read. If referencing specific files or data, you must read them first before answering. Before proposing solutions, always check relevant files and data. When answering knowledge questions, cite sources you actually retrieved, don't fabricate.",
        "progressive_work_pattern": "This is a long task. Progress incrementally, focusing on a few items at a time. Track your progress. Don't exhaust context with large uncommitted work. Systematically continue until the task is complete. Before context window approaches limits, save current progress and state to memory/file.",
        "parallel_execution": "If you plan to call multiple tools with no inter-dependencies, make all independent tool calls in parallel. Prioritize simultaneous calls when operations can be parallel rather than sequential.",
        "anti_overengineering": "Only make changes that are directly requested or clearly necessary. Keep solutions simple and focused. Don't add features, refactor code, or make 'improvements' beyond requirements.",
        "source_verification": "When gathering data, verify information across multiple sources. Develop competing hypotheses. Track confidence levels. Periodically self-critique methods and plans."
      },
      "providers": {
        "deepseek": {
          "endpoint": "https://api.deepseek.com",
          "api_key": "",
          "model": "deepseek-v4-pro",
          "comment": "api_key从DEEPSEEK_API_KEY环境变量读取。支持模型: deepseek-v4-pro, deepseek-v4-flash"
        },
        "aliyun": {
          "endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1",
          "api_key": "",
          "model": "qwen-plus",
          "comment": "api_key从DASHSCOPE_API_KEY或ALIYUN_API_KEY环境变量读取。支持chat+embedding+vision"
        },
        "siliconflow": {
          "endpoint": "https://api.siliconflow.cn",
          "api_key": "",
          "model": "BAAI/bge-large-zh-v1.5",
          "comment": "L0 embedding备选。api_key从SILICONFLOW_API_KEY环境变量读取"
        }
      },
      "provider_catalog": {
        "entries": [
          {
            "name": "deepseek",
            "base_url": "https://api.deepseek.com/v1",
            "default_model": "deepseek-v4-pro",
            "capabilities": [
              "code",
              "reasoning",
              "analysis",
              "thinking",
              "tool_calls",
              "json_mode",
              "fim"
            ]
          },
          {
            "name": "aliyun",
            "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
            "default_model": "qwen-plus",
            "capabilities": [
              "code",
              "reasoning",
              "embedding",
              "vision",
              "web_search",
              "document",
              "audio",
              "function_calling"
            ]
          },
          {
            "name": "siliconflow",
            "base_url": "https://api.siliconflow.cn/v1",
            "default_model": "deepseek-ai/DeepSeek-V3",
            "capabilities": [
              "code",
              "reasoning",
              "embedding",
              "vision"
            ]
          },
          {
            "name": "openai",
            "base_url": "https://api.openai.com/v1",
            "default_model": "gpt-4o",
            "capabilities": [
              "multimodal",
              "code",
              "reasoning",
              "vision"
            ]
          },
          {
            "name": "anthropic",
            "base_url": "https://api.anthropic.com/v1",
            "default_model": "claude-3-5-sonnet-20241022",
            "capabilities": [
              "long_context",
              "safety",
              "code",
              "reasoning"
            ]
          },
          {
            "name": "gemini",
            "base_url": "https://generativelanguage.googleapis.com/v1beta",
            "default_model": "gemini-2.0-flash",
            "capabilities": [
              "vision",
              "search",
              "multimodal"
            ]
          },
          {
            "name": "ollama",
            "base_url": "http://localhost:11434/v1",
            "default_model": "qwen3.5:4b",
            "capabilities": [
              "code",
              "reasoning",
              "privacy",
              "local"
            ]
          },
          {
            "name": "vllm",
            "base_url": "http://localhost:8000/v1",
            "default_model": "Qwen/Qwen2.5-7B-Instruct",
            "capabilities": [
              "code",
              "reasoning",
              "privacy",
              "local"
            ]
          }
        ]
      }
    },
    "Web": {
      "host": "0.0.0.0",
      "port": 8080,
      "rate_limit_per_minute": 60
    },
    "Vector": {
      "dimension": 384,
      "backend": "hnsw",
      "cache_size_mb": 256
    },
    "Network": {
      "p2p_port": 9090,
      "discovery_endpoint": ""
    },
    "integration_urls": {
      "weather_openweathermap": "https://api.openweathermap.org/data/2.5/weather",
      "weather_qweather_geo": "https://geoapi.qweather.com/v2/city/lookup",
      "weather_qweather_now": "https://devapi.qweather.com/v7/weather/now",
      "translate_baidu": "https://fanyi-api.baidu.com/api/trans/vip/translate",
      "sms_aliyun": "https://dysmsapi.aliyuncs.com/",
      "maps_baidu": "https://api.map.baidu.com/",
      "maps_amap": "https://restapi.amap.com/",
      "maps_tencent": "https://apis.map.qq.com/",
      "maps_tianditu": "https://t{s}.tianditu.gov.cn/",
      "imagesearch_unsplash": "https://api.unsplash.com/search/photos",
      "imagesearch_pixabay": "https://pixabay.com/api/",
      "telegram_base": "https://api.telegram.org",
      "ollama_url": "http://localhost:11434",
      "ffmpeg_path": "tools/ffmpeg.exe",
      "sandbox_remote_url": "http://localhost:8000"
    },
    "thresholds": {
      "consolidation_learning_rate": 0.015,
      "consolidation_decay_rate": 0.999,
      "consolidation_interval_minutes": 2,
      "evolution_mutation_rate": 0.3,
      "retrieval_zero_result_warning_rate": 0.15,
      "loafing_threshold": 0.35
    },
    "model_pricing": {
      "_comment": "moved to appsettings.Pricing.json"
    },
    "social_load": {
      "_comment": "moved to appsettings.Pricing.json"
    },
    "stealth_browser": {
      "enabled": false,
      "_comment": "full config moved to appsettings.Integrations.json"
    },
    "tools_auto": {
      "_comment": "auto-download tools config moved to appsettings.Integrations.json"
    },
    "http_accelerator": {
      "enabled": true
    },
    "supertonic": {
      "enabled": false,
      "server_url": "http://127.0.0.1:7788",
      "default_voice": "M1",
      "model": "supertonic-3",
      "total_steps": 8,
      "speed": 1.05,
      "auto_start_server": false,
      "onnx_dir": "assets/onnx",
      "voice_style_dir": "assets/voice_styles",
      "_comment": "Supertonic 3 TTS — 原生 ONNX Runtime 推理。下载模型: git clone https://huggingface.co/Supertone/supertonic-3 assets。启动后自动检测 4 个 ONNX 模型文件直接推理，无需 HTTP 服务器。"
    }
  }
}
