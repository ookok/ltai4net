{
  "LTAI": {
    "data_directory": ".livingtree",
    "AI": {
      "default_provider": "deepseek",
      "l0": {
        "provider": "siliconflow",
        "model": "BAAI/bge-large-zh-v1.5"
      },
      "l1": {
        "provider": "deepseek",
        "model": "deepseek-v4-flash",
        "temperature": 0.3
      },
      "l2": {
        "provider": "deepseek",
        "model": "deepseek-v4-pro",
        "temperature": 0.3
      },
      "daily_budget_usd": 10.00,
      "default_temperature": 0.3,
      "max_tokens": 4096,
      "timeout_ms": 60000,
      "max_collaboration_rounds": 5,
      "system_prompts": {
        "investigate_before_answering": "Never speculate about content you haven't read. If referencing specific files or data, you must read them first before answering. Before proposing solutions, always check relevant files and data. When answering knowledge questions, cite sources you actually retrieved, don't fabricate. Ensure answers are pragmatic, accurate, and hallucination-free.",
        "progressive_work_pattern": "This is a long task. Progress incrementally, focusing on a few items at a time. Track your progress. Don't exhaust context with large uncommitted work. Systematically continue until the task is complete. Before context window approaches limits, save current progress and state to memory/file.",
        "parallel_execution": "If you plan to call multiple tools with no inter-dependencies, make all independent tool calls in parallel. Prioritize simultaneous calls when operations can be parallel rather than sequential. For example: read multiple files at once, make multiple search queries at once. Maximize parallelism for speed and efficiency.",
        "anti_overengineering": "Only make changes that are directly requested or clearly necessary. Keep solutions simple and focused. Don't add features, refactor code, or make 'improvements' beyond requirements. Don't design for hypothetical future needs. The right complexity is the minimum needed for the current task.",
        "source_verification": "When gathering data, verify information across multiple sources. Develop competing hypotheses. Track confidence levels. Periodically self-critique methods and plans. Persist findings to files for transparency."
      },
      "providers": {
        "deepseek": {
          "endpoint": "https://api.deepseek.com",
          "api_key": "",
          "model": "deepseek-chat"
        },
        "siliconflow": {
          "endpoint": "https://api.siliconflow.cn",
          "api_key": "",
          "model": "BAAI/bge-large-zh-v1.5"
        }
      },
      "provider_catalog": {
        "entries": [
          { "name": "deepseek", "base_url": "https://api.deepseek.com/v1", "default_model": "deepseek-chat", "capabilities": ["code", "reasoning", "analysis"] },
          { "name": "openai", "base_url": "https://api.openai.com/v1", "default_model": "gpt-4o", "capabilities": ["multimodal", "code", "reasoning", "vision"] },
          { "name": "anthropic", "base_url": "https://api.anthropic.com/v1", "default_model": "claude-3-5-sonnet-20241022", "capabilities": ["long_context", "safety", "code", "reasoning"] },
          { "name": "gemini", "base_url": "https://generativelanguage.googleapis.com/v1beta", "default_model": "gemini-2.0-flash", "capabilities": ["vision", "search", "multimodal"] },
          { "name": "ollama", "base_url": "http://localhost:11434/v1", "default_model": "qwen3.5:4b", "capabilities": ["code", "reasoning", "privacy", "local"] },
          { "name": "lmstudio", "base_url": "http://localhost:1234/v1", "default_model": "qwen2.5-7b-instruct", "capabilities": ["code", "reasoning", "privacy", "local"] },
          { "name": "vllm", "base_url": "http://localhost:8000/v1", "default_model": "Qwen/Qwen2.5-7B-Instruct", "capabilities": ["code", "reasoning", "privacy", "local"] },
          { "name": "llamacpp", "base_url": "http://localhost:8080/v1", "default_model": "qwen2.5-7b-instruct", "capabilities": ["code", "reasoning", "privacy", "local"] },
          { "name": "open_webui", "base_url": "http://localhost:3000/api/v1", "default_model": "qwen3.5:4b", "capabilities": ["code", "reasoning", "privacy", "local"] }
        ]
      }
    },
    "Web": {
      "host": "0.0.0.0",
      "port": 8080,
      "rate_limit_per_minute": 60
    },
    "Vector": {
      "dimension": 384,
      "backend": "hnsw",
      "cache_size_mb": 256
    },
    "Network": {
      "p2p_port": 9090,
      "discovery_endpoint": ""
    },
    "integration_urls": {
      "weather_openweathermap": "https://api.openweathermap.org/data/2.5/weather",
      "weather_qweather_geo": "https://geoapi.qweather.com/v2/city/lookup",
      "weather_qweather_now": "https://devapi.qweather.com/v7/weather/now",
      "translate_baidu": "https://fanyi-api.baidu.com/api/trans/vip/translate",
      "sms_aliyun": "https://dysmsapi.aliyuncs.com/",
      "maps_baidu": "https://api.map.baidu.com/",
      "maps_amap": "https://restapi.amap.com/",
      "maps_tencent": "https://apis.map.qq.com/",
      "maps_tianditu": "https://t{s}.tianditu.gov.cn/",
      "imagesearch_unsplash": "https://api.unsplash.com/search/photos",
      "imagesearch_pixabay": "https://pixabay.com/api/",
      "telegram_base": "https://api.telegram.org",
      "ollama_url": "http://localhost:11434",
      "ffmpeg_path": "tools/ffmpeg.exe",
      "sandbox_remote_url": "http://localhost:8000"
    },
    "thresholds": {
      "consolidation_learning_rate": 0.015,
      "consolidation_decay_rate": 0.999,
      "consolidation_interval_minutes": 2,
      "grpo_learning_rate": 0.02,
      "evolution_population_size": 32,
      "evolution_mutation_rate": 0.3,
      "retrieval_zero_result_warning_rate": 0.15,
      "retrieval_recall_drift_warning_percent": 5.0,
      "loafing_threshold": 0.35,
      "sovereignty_gap_threshold": 0.25,
      "purge_hot_threshold_sec": 3600,
      "purge_warm_threshold_sec": 86400
    },
    "model_pricing": {
      "input_per_1m": {
        "gpt-4o": 2.50,
        "gpt-4o-mini": 0.15,
        "claude-sonnet": 3.00,
        "claude-haiku": 0.25,
        "deepseek-v3": 0.27,
        "deepseek-r1": 0.55,
        "deepseek-v4-pro": 3.0,
        "deepseek-v4-flash": 1.0,
        "qwen-max": 0.40,
        "qwen-turbo": 0.08,
        "qwen3.6-plus": 2.90,
        "qwen3.6-flash": 0.73,
        "qwen3.6-max": 8.70,
        "qwq-plus": 5.80,
        "qvq-max": 8.70,
        "sensetime": 0.0,
        "default": 0.50
      },
      "output_per_1m": {
        "gpt-4o": 10.00,
        "gpt-4o-mini": 0.60,
        "claude-sonnet": 15.00,
        "claude-haiku": 1.25,
        "deepseek-v3": 1.10,
        "deepseek-r1": 2.19,
        "deepseek-v4-pro": 6.0,
        "deepseek-v4-flash": 2.0,
        "qwen-max": 1.60,
        "qwen-turbo": 0.32,
        "qwen3.6-plus": 17.40,
        "qwen3.6-flash": 2.90,
        "qwen3.6-max": 43.50,
        "qwq-plus": 11.60,
        "qvq-max": 17.40,
        "sensetime": 0.0,
        "default": 2.00
      },
      "degradation_chain": {
        "gpt-4o": "gpt-4o-mini",
        "claude-sonnet": "claude-haiku",
        "deepseek-r1": "deepseek-v3",
        "deepseek-v4-pro": "deepseek-v4-flash",
        "qwen-max": "qwen-turbo",
        "qwen3.6-max": "qwen3.6-flash"
      }
    },
    "social_load": {
      "resilience": {
        "claude": 5.0,
        "gemini": 1.5,
        "gpt": 1.0,
        "qwen": 1.2,
        "default": 1.0
      },
      "base_authority": {
        "claude": 0.9,
        "gemini": 0.75,
        "gpt": 0.7,
        "qwen": 0.65,
        "default": 0.5
      }
    },
    "stealth_browser": {
      "enabled": true,
      "engine": "cloakbrowser",
      "executable_path": "",
      "auto_download": true,
      "download_url": "https://github.com/CloakHQ/CloakBrowser/releases/latest/download",
      "download_mirror": "https://gitee.com/mirrors/cloakbrowser/releases/latest/download",
      "cache_dir": ".livingtree/browser/stealth",
      "docker_image": "cloakhq/cloakbrowser:latest",
      "cdp_port": 9222,
      "headless": true,
      "humanize": false,
      "launch_timeout_ms": 30000,
      "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36"
    },
    "tools_auto": {
      "auto_download": true,
      "download_dir": ".livingtree/tools",
      "wsl2": { "enabled": true, "name": "WSL2", "install_url": "https://aka.ms/wslstorepage", "auto_install_distro": "Ubuntu-24.04" },
      "python": { "enabled": true, "name": "Python", "install_url": "https://www.python.org/downloads/", "min_version": "3.10" },
      "nodejs": { "enabled": true, "name": "Node.js", "install_url": "https://nodejs.org/dist/v22.11.0/", "min_version": "20.0" },
      "dotnet_sdk": { "enabled": true, "name": ".NET SDK", "install_url": "https://dotnet.microsoft.com/download", "min_version": "10.0" },
      "ffmpeg": { "enabled": false, "name": "FFmpeg", "install_url": "https://ffmpeg.org/download.html" },
      "ripgrep": { "enabled": true, "name": "ripgrep", "install_url": "https://github.com/BurntSushi/ripgrep/releases", "min_version": "14.0" },
      "fd": { "enabled": true, "name": "fd-find", "install_url": "https://github.com/sharkdp/fd/releases", "min_version": "9.0" },
      "jq": { "enabled": true, "name": "jq", "install_url": "https://github.com/jqlang/jq/releases", "min_version": "1.7" },
      "delta": { "enabled": false, "name": "git-delta", "install_url": "https://github.com/dandavison/delta/releases" },
      "bat": { "enabled": false, "name": "bat", "install_url": "https://github.com/sharkdp/bat/releases" }
    },
    "http_accelerator": {
      "enabled": true,
      "comment": "本地反代加速国外开发站点下载(GitHub/PyPI/npm/Docker等)"
    }
  }
}
