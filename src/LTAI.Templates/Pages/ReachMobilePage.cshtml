@page "/templates/reach-mobile"
@{
    ViewData["Title"] = "Reach Mobile";
    Layout = "_Layout";
}

<div class="max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold text-lime-400 mb-6">Mobile Device Pairing</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-gray-800 rounded-lg p-6 border border-gray-700 text-center">
            <h2 class="text-lg font-semibold text-lime-400 mb-4">Scan to Connect</h2>
            <div class="bg-white inline-block p-3 rounded-lg mb-3">
                <svg viewBox="0 0 120 120" class="w-40 h-40">
                    <rect x="4" y="4" width="112" height="112" rx="4" fill="#111" />
                    <rect x="8" y="8" width="28" height="28" rx="2" fill="#a3e635" />
                    <rect x="12" y="12" width="20" height="20" rx="1" fill="#111" />
                    <rect x="84" y="8" width="28" height="28" rx="2" fill="#a3e635" />
                    <rect x="88" y="12" width="20" height="20" rx="1" fill="#111" />
                    <rect x="8" y="84" width="28" height="28" rx="2" fill="#a3e635" />
                    <rect x="12" y="88" width="20" height="20" rx="1" fill="#111" />
                    <rect x="48" y="16" width="4" height="4" fill="#a3e635" /><rect x="56" y="16" width="4" height="4" fill="#111" /><rect x="64" y="16" width="4" height="4" fill="#a3e635" />
                    <rect x="48" y="24" width="4" height="4" fill="#111" /><rect x="56" y="24" width="4" height="4" fill="#a3e635" /><rect x="64" y="24" width="4" height="4" fill="#111" />
                    <rect x="48" y="32" width="4" height="4" fill="#a3e635" /><rect x="56" y="32" width="4" height="4" fill="#111" /><rect x="64" y="32" width="4" height="4" fill="#a3e635" />
                    <rect x="16" y="48" width="4" height="4" fill="#111" /><rect x="24" y="48" width="4" height="4" fill="#a3e635" /><rect x="32" y="48" width="4" height="4" fill="#111" /><rect x="40" y="48" width="4" height="4" fill="#a3e635" /><rect x="48" y="48" width="4" height="4" fill="#111" /><rect x="56" y="48" width="4" height="4" fill="#a3e635" /><rect x="64" y="48" width="4" height="4" fill="#111" /><rect x="72" y="48" width="4" height="4" fill="#a3e635" /><rect x="80" y="48" width="4" height="4" fill="#111" /><rect x="88" y="48" width="4" height="4" fill="#a3e635" /><rect x="96" y="48" width="4" height="4" fill="#111" /><rect x="104" y="48" width="4" height="4" fill="#a3e635" />
                    <rect x="16" y="56" width="4" height="4" fill="#a3e635" /><rect x="24" y="56" width="4" height="4" fill="#111" /><rect x="32" y="56" width="4" height="4" fill="#a3e635" /><rect x="40" y="56" width="4" height="4" fill="#111" /><rect x="48" y="56" width="4" height="4" fill="#a3e635" /><rect x="56" y="56" width="4" height="4" fill="#111" /><rect x="64" y="56" width="4" height="4" fill="#a3e635" /><rect x="72" y="56" width="4" height="4" fill="#111" /><rect x="80" y="56" width="4" height="4" fill="#a3e635" /><rect x="88" y="56" width="4" height="4" fill="#111" /><rect x="96" y="56" width="4" height="4" fill="#a3e635" /><rect x="104" y="56" width="4" height="4" fill="#111" />
                    <rect x="16" y="64" width="4" height="4" fill="#111" /><rect x="24" y="64" width="4" height="4" fill="#a3e635" /><rect x="32" y="64" width="4" height="4" fill="#111" /><rect x="40" y="64" width="4" height="4" fill="#a3e635" /><rect x="48" y="64" width="4" height="4" fill="#111" /><rect x="56" y="64" width="4" height="4" fill="#a3e635" /><rect x="64" y="64" width="4" height="4" fill="#111" /><rect x="72" y="64" width="4" height="4" fill="#a3e635" /><rect x="80" y="64" width="4" height="4" fill="#111" /><rect x="88" y="64" width="4" height="4" fill="#a3e635" /><rect x="96" y="64" width="4" height="4" fill="#111" /><rect x="104" y="64" width="4" height="4" fill="#a3e635" />
                    <rect x="48" y="80" width="4" height="4" fill="#a3e635" /><rect x="56" y="80" width="4" height="4" fill="#111" /><rect x="64" y="80" width="4" height="4" fill="#a3e635" />
                    <rect x="48" y="88" width="4" height="4" fill="#111" /><rect x="56" y="88" width="4" height="4" fill="#a3e635" /><rect x="64" y="88" width="4" height="4" fill="#111" />
                    <rect x="48" y="96" width="4" height="4" fill="#a3e635" /><rect x="56" y="96" width="4" height="4" fill="#111" /><rect x="64" y="96" width="4" height="4" fill="#a3e635" />
                </svg>
            </div>
            <p class="text-xs text-gray-500">Open the LTAI Reach app and scan this code to pair</p>
            <p class="text-xs text-gray-600 mt-1">Session ID: <span class="font-mono text-lime-400">ltai-reach-a3f7c8e1</span></p>
        </div>

        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-lg font-semibold text-lime-400 mb-3">Connected Devices</h2>
            <div id="connected-devices" hx-get="/api/reach/devices" hx-trigger="load, every 5s" hx-swap="innerHTML">
                <div class="space-y-3">
                    <div class="bg-gray-750 rounded p-3 border border-gray-700 flex items-center gap-3">
                        <div class="w-3 h-3 bg-green-400 rounded-full"></div>
                        <div class="flex-1">
                            <p class="text-sm">Pixel 8 Pro</p>
                            <p class="text-xs text-gray-500">Android 15 · Reach v2.1.0</p>
                        </div>
                        <span class="text-xs text-green-400">Active</span>
                    </div>
                    <div class="bg-gray-750 rounded p-3 border border-gray-700 flex items-center gap-3">
                        <div class="w-3 h-3 bg-gray-500 rounded-full"></div>
                        <div class="flex-1">
                            <p class="text-sm">iPad Air</p>
                            <p class="text-xs text-gray-500">iOS 19 · Reach v2.0.8</p>
                        </div>
                        <span class="text-xs text-gray-500">Standby</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-gray-800 rounded-lg p-4 border border-gray-700 mt-6">
        <h2 class="text-lg font-semibold text-lime-400 mb-3">Sensor Requests</h2>
        <div id="sensor-requests" hx-get="/api/reach/sensors" hx-trigger="load, every 3s" hx-swap="innerHTML">
            <div class="space-y-3">
                <div class="bg-gray-750 rounded p-3 border border-gray-700">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-sm text-gray-300">Camera Capture</span>
                        <span class="text-xs text-yellow-400">Requested</span>
                    </div>
                    <div class="flex gap-2">
                        <button hx-post="/api/reach/sensors/camera/approve" class="bg-green-700 hover:bg-green-600 text-white rounded px-3 py-1 text-xs transition-colors">Approve</button>
                        <button hx-post="/api/reach/sensors/camera/deny" class="bg-red-700 hover:bg-red-600 text-white rounded px-3 py-1 text-xs transition-colors">Deny</button>
                    </div>
                </div>
                <div class="bg-gray-750 rounded p-3 border border-gray-700">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-sm text-gray-300">Location Access</span>
                        <span class="text-xs text-green-400">Approved</span>
                    </div>
                    <p class="text-xs text-gray-500">Precision: 10m · Last update: 2s ago</p>
                    <p class="text-xs text-gray-600 font-mono mt-1">34.0522° N, 118.2437° W</p>
                </div>
                <div class="bg-gray-750 rounded p-3 border border-gray-700">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-sm text-gray-300">Microphone Stream</span>
                        <span class="text-xs text-gray-500">Idle</span>
                    </div>
                    <p class="text-xs text-gray-500">No active recording</p>
                </div>
            </div>
        </div>
    </div>
</div>
