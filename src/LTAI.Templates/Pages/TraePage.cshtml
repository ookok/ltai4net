@page "/templates/trae"
@{
    ViewData["Title"] = "Training Evolution";
    Layout = "_Layout";
}

<div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-teal-400 mb-6">Training Evolution View</h1>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6" hx-get="/api/trae/stats" hx-trigger="load, every 5s" hx-swap="innerHTML">
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-xs text-gray-400 uppercase tracking-wide">Generation</h2>
            <p class="text-2xl font-mono text-teal-400 mt-1">142</p>
            <p class="text-xs text-gray-500 mt-1">of 500</p>
        </div>
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-xs text-gray-400 uppercase tracking-wide">Population</h2>
            <p class="text-2xl font-mono text-green-400 mt-1">64</p>
            <p class="text-xs text-gray-500 mt-1">individuals</p>
        </div>
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-xs text-gray-400 uppercase tracking-wide">Best Fitness</h2>
            <p class="text-2xl font-mono text-yellow-400 mt-1">0.914</p>
            <p class="text-xs text-gray-500 mt-1">max score</p>
        </div>
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-xs text-gray-400 uppercase tracking-wide">Avg Fitness</h2>
            <p class="text-2xl font-mono text-purple-400 mt-1">0.682</p>
            <p class="text-xs text-gray-500 mt-1">population mean</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-lg font-semibold text-teal-400 mb-3">Fitness Over Generations</h2>
            <canvas id="fitnessChart" class="w-full h-64"></canvas>
        </div>
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-lg font-semibold text-teal-400 mb-3">Mutation Stats</h2>
            <div id="mutation-stats" hx-get="/api/trae/mutations" hx-trigger="load, every 5s" hx-swap="innerHTML">
                <div class="space-y-4">
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-400">Mutation Rate</span>
                            <span class="text-teal-400 font-mono">0.05</span>
                        </div>
                        <div class="w-full bg-gray-700 rounded-full h-2">
                            <div class="bg-teal-400 h-2 rounded-full" style="width:5%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-400">Crossover Rate</span>
                            <span class="text-teal-400 font-mono">0.70</span>
                        </div>
                        <div class="w-full bg-gray-700 rounded-full h-2">
                            <div class="bg-teal-400 h-2 rounded-full" style="width:70%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-400">Elite Preservation</span>
                            <span class="text-teal-400 font-mono">4 of 64</span>
                        </div>
                        <div class="w-full bg-gray-700 rounded-full h-2">
                            <div class="bg-teal-400 h-2 rounded-full" style="width:6.25%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
        <h2 class="text-lg font-semibold text-teal-400 mb-3">Elite Pool</h2>
        <div id="elite-pool" hx-get="/api/trae/elites" hx-trigger="load, every 10s" hx-swap="innerHTML">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-gray-400 border-b border-gray-700">
                        <th class="text-left py-2">Rank</th>
                        <th class="text-left py-2">ID</th>
                        <th class="text-left py-2">Fitness</th>
                        <th class="text-left py-2">Generation</th>
                        <th class="text-left py-2">Strategy</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="border-b border-gray-750">
                        <td class="py-2 text-yellow-400 font-mono">#1</td>
                        <td class="py-2 font-mono">genome-a3f7</td>
                        <td class="py-2 text-green-400 font-mono">0.914</td>
                        <td class="py-2 text-gray-400">142</td>
                        <td class="py-2 text-xs text-gray-400">Multi-hop reasoning</td>
                    </tr>
                    <tr class="border-b border-gray-750">
                        <td class="py-2 text-gray-400 font-mono">#2</td>
                        <td class="py-2 font-mono">genome-c8e1</td>
                        <td class="py-2 text-green-400 font-mono">0.887</td>
                        <td class="py-2 text-gray-400">138</td>
                        <td class="py-2 text-xs text-gray-400">Chain-of-thought</td>
                    </tr>
                    <tr class="border-b border-gray-750">
                        <td class="py-2 text-gray-400 font-mono">#3</td>
                        <td class="py-2 font-mono">genome-b4d2</td>
                        <td class="py-2 text-green-400 font-mono">0.861</td>
                        <td class="py-2 text-gray-400">141</td>
                        <td class="py-2 text-xs text-gray-400">Recursive self-check</td>
                    </tr>
                    <tr>
                        <td class="py-2 text-gray-400 font-mono">#4</td>
                        <td class="py-2 font-mono">genome-f9a0</td>
                        <td class="py-2 text-green-400 font-mono">0.843</td>
                        <td class="py-2 text-gray-400">140</td>
                        <td class="py-2 text-xs text-gray-400">Tool-augmented</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
(function() {
    const ctx = document.getElementById('fitnessChart');
    if (!ctx) return;
    const gens = Array.from({length:20}, (_,i) => 123 + i);
    const best = [0.78,0.79,0.79,0.80,0.81,0.81,0.82,0.83,0.84,0.85,0.85,0.87,0.88,0.89,0.89,0.90,0.90,0.91,0.91,0.914];
    const avg = [0.52,0.53,0.54,0.54,0.55,0.56,0.57,0.58,0.59,0.60,0.61,0.62,0.63,0.64,0.65,0.66,0.67,0.67,0.68,0.682];
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: gens,
            datasets: [
                { label: 'Best Fitness', data: best, borderColor: '#facc15', backgroundColor: 'rgba(250,204,21,0.1)', fill: true, tension: 0.3, pointRadius: 2 },
                { label: 'Avg Fitness', data: avg, borderColor: '#a78bfa', backgroundColor: 'rgba(167,139,250,0.1)', fill: true, tension: 0.3, pointRadius: 2 }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: { ticks: { color: '#9ca3af' }, grid: { color: '#374151' } },
                y: { min: 0, max: 1, ticks: { color: '#9ca3af' }, grid: { color: '#374151' } }
            },
            plugins: { legend: { labels: { color: '#9ca3af' } } }
        }
    });
})();
</script>
