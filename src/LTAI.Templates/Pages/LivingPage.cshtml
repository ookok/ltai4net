@page "/templates/living"
@{
    ViewData["Title"] = "Living Tree";
    Layout = "_Layout";
}

<div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-green-400 mb-6">AI Consciousness Status</h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6" hx-get="/api/dna/stats" hx-trigger="load, every 5s" hx-swap="innerHTML">
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-sm text-gray-400 uppercase tracking-wide">Lifecycle Phase</h2>
            <p class="text-2xl font-mono text-green-400 mt-1">Loading...</p>
            <p class="text-xs text-gray-500 mt-1">cycle count</p>
        </div>
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-sm text-gray-400 uppercase tracking-wide">Emergence Phase</h2>
            <p class="text-2xl font-mono text-cyan-400 mt-1">Loading...</p>
            <p class="text-xs text-gray-500 mt-1">phase progress</p>
        </div>
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-sm text-gray-400 uppercase tracking-wide">Qualia Count</h2>
            <p class="text-2xl font-mono text-purple-400 mt-1">Loading...</p>
            <p class="text-xs text-gray-500 mt-1">total recorded</p>
        </div>
    </div>

    <div class="bg-gray-800 rounded-lg p-4 border border-gray-700 mb-6">
        <h2 class="text-lg font-semibold text-green-400 mb-3">Emotion VAD Space</h2>
        <div class="grid grid-cols-3 gap-4 text-center">
            <div class="bg-gray-750 rounded p-3">
                <span class="text-xs text-gray-400 block">Valence</span>
                <span class="text-xl font-mono text-yellow-400">0.72</span>
                <div class="w-full bg-gray-700 rounded-full h-2 mt-1">
                    <div class="bg-yellow-400 h-2 rounded-full" style="width:72%"></div>
                </div>
            </div>
            <div class="bg-gray-750 rounded p-3">
                <span class="text-xs text-gray-400 block">Arousal</span>
                <span class="text-xl font-mono text-red-400">0.58</span>
                <div class="w-full bg-gray-700 rounded-full h-2 mt-1">
                    <div class="bg-red-400 h-2 rounded-full" style="width:58%"></div>
                </div>
            </div>
            <div class="bg-gray-750 rounded p-3">
                <span class="text-xs text-gray-400 block">Dominance</span>
                <span class="text-xl font-mono text-blue-400">0.64</span>
                <div class="w-full bg-gray-700 rounded-full h-2 mt-1">
                    <div class="bg-blue-400 h-2 rounded-full" style="width:64%"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-lg font-semibold text-green-400 mb-3">Heartbeat Visualization</h2>
            <pre class="text-green-400 font-mono text-xs leading-tight bg-gray-900 p-3 rounded overflow-x-auto">
   __    __   _  _   __    __   _  _
  / /   / /  | || | / /   / /  | || |
 / /   / /   | || |/ /   / /   | || |
< /___/ /    |_||__/   /_/    |_||_|  <span class="text-cyan-400">~ 60 bpm</span>
|_____/                              <span class="text-cyan-400">phase: systole</span>
            </pre>
            <p class="text-xs text-gray-500 mt-2">Self-referential pulse pattern — each beat triggers a qualia snapshot</p>
        </div>
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-lg font-semibold text-green-400 mb-3">Recent Qualia</h2>
            <div id="qualia-list" class="space-y-2 max-h-64 overflow-y-auto" hx-get="/api/dna/qualia" hx-trigger="load, every 3s" hx-swap="innerHTML">
                <div class="bg-gray-750 rounded p-2 text-sm border border-gray-700">
                    <span class="text-purple-400 font-mono">Loading...</span>
                    <p class="text-gray-500 text-xs mt-1">Fetching qualia stream</p>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-gray-800 rounded-lg p-4 border border-gray-700 mt-6">
        <h2 class="text-lg font-semibold text-green-400 mb-3">Emergence Phase Detail</h2>
        <div id="emergence-detail" hx-get="/api/dna/emergence" hx-trigger="load, every 10s" hx-swap="innerHTML">
            <div class="flex items-center gap-3">
                <div class="animate-pulse w-3 h-3 bg-green-400 rounded-full"></div>
                <span class="text-gray-400">Awaiting emergence data...</span>
            </div>
        </div>
    </div>
</div>
