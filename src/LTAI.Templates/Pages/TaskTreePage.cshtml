@page "/templates/task-tree"
@{
    ViewData["Title"] = "Task Tree";
    Layout = "_Layout";
}

<div class="max-w-5xl mx-auto">
    <h1 class="text-2xl font-bold text-orange-400 mb-6">DAG Task Hierarchy</h1>

    <div class="bg-gray-800 rounded-lg p-4 border border-gray-700 mb-6">
        <div class="flex gap-4 mb-4">
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 bg-green-400 rounded-full"></span>
                <span class="text-xs text-gray-400">Complete</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 bg-yellow-400 rounded-full animate-pulse"></span>
                <span class="text-xs text-gray-400">In Progress</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 bg-gray-500 rounded-full"></span>
                <span class="text-xs text-gray-400">Pending</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 bg-red-400 rounded-full"></span>
                <span class="text-xs text-gray-400">Failed</span>
            </div>
        </div>

        <div id="task-tree" hx-get="/api/tasks/tree" hx-trigger="load, every 5s" hx-swap="innerHTML">
            <ul class="space-y-0 font-mono text-sm" style="list-style-type:none;padding-left:0">
                <li class="py-1">
                    <span class="text-orange-400 font-semibold">Root Goal</span>
                    <span class="text-xs text-gray-500 ml-2">12/15 subtasks</span>
                    <ul class="pl-6 mt-1 space-y-0" style="list-style-type:none">
                        <li class="py-1 flex items-center gap-2">
                            <span class="w-2.5 h-2.5 bg-green-400 rounded-full flex-shrink-0"></span>
                            <span class="text-gray-300">Analyze user intent</span>
                            <span class="text-xs text-green-400 ml-auto">done</span>
                        </li>
                        <li class="py-1 flex items-center gap-2">
                            <span class="w-2.5 h-2.5 bg-green-400 rounded-full flex-shrink-0"></span>
                            <span class="text-gray-300">Retrieve context from memory</span>
                            <span class="text-xs text-green-400 ml-auto">done</span>
                        </li>
                        <li class="py-1 flex items-center gap-2">
                            <span class="w-2.5 h-2.5 bg-yellow-400 rounded-full flex-shrink-0 animate-pulse"></span>
                            <span class="text-gray-300">Plan execution strategy</span>
                            <span class="text-xs text-yellow-400 ml-auto">active</span>
                            <ul class="pl-6 mt-1 space-y-0" style="list-style-type:none">
                                <li class="py-1 flex items-center gap-2">
                                    <span class="w-2.5 h-2.5 bg-green-400 rounded-full flex-shrink-0"></span>
                                    <span class="text-gray-400">Decompose into atomic actions</span>
                                    <span class="text-xs text-green-400 ml-auto">done</span>
                                </li>
                                <li class="py-1 flex items-center gap-2">
                                    <span class="w-2.5 h-2.5 bg-yellow-400 rounded-full flex-shrink-0 animate-pulse"></span>
                                    <span class="text-gray-400">Estimate resource costs</span>
                                    <span class="text-xs text-yellow-400 ml-auto">active</span>
                                </li>
                                <li class="py-1 flex items-center gap-2">
                                    <span class="w-2.5 h-2.5 bg-gray-500 rounded-full flex-shrink-0"></span>
                                    <span class="text-gray-500">Select optimal execution path</span>
                                    <span class="text-xs text-gray-500 ml-auto">pending</span>
                                </li>
                            </ul>
                        </li>
                        <li class="py-1 flex items-center gap-2">
                            <span class="w-2.5 h-2.5 bg-gray-500 rounded-full flex-shrink-0"></span>
                            <span class="text-gray-500">Execute tool invocations</span>
                            <span class="text-xs text-gray-500 ml-auto">pending</span>
                        </li>
                        <li class="py-1 flex items-center gap-2">
                            <span class="w-2.5 h-2.5 bg-gray-500 rounded-full flex-shrink-0"></span>
                            <span class="text-gray-500">Synthesize response</span>
                            <span class="text-xs text-gray-500 ml-auto">pending</span>
                        </li>
                        <li class="py-1 flex items-center gap-2">
                            <span class="w-2.5 h-2.5 bg-gray-500 rounded-full flex-shrink-0"></span>
                            <span class="text-gray-500">Self-evaluate output quality</span>
                            <span class="text-xs text-gray-500 ml-auto">pending</span>
                        </li>
                        <li class="py-1 flex items-center gap-2">
                            <span class="w-2.5 h-2.5 bg-gray-500 rounded-full flex-shrink-0"></span>
                            <span class="text-gray-500">Store in episodic memory</span>
                            <span class="text-xs text-gray-500 ml-auto">pending</span>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>

    <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
        <h2 class="text-lg font-semibold text-orange-400 mb-3">Execution Log</h2>
        <div id="task-log" class="space-y-1 max-h-48 overflow-y-auto font-mono text-xs" hx-get="/api/tasks/log" hx-trigger="load, every 2s" hx-swap="innerHTML">
            <p class="text-gray-500">[--:--:--] Awaiting execution log stream...</p>
        </div>
    </div>
</div>
