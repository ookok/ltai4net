@page "/templates/dashboard"
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-blue-400 mb-6">System Health Dashboard</h1>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6" hx-get="/api/core/health" hx-trigger="load, every 3s" hx-swap="innerHTML">
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-xs text-gray-400 uppercase tracking-wide">CPU</h2>
            <p class="text-xl font-mono text-cyan-400 mt-1">--%</p>
            <p class="text-xs text-gray-500 mt-1">cores</p>
        </div>
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-xs text-gray-400 uppercase tracking-wide">Memory</h2>
            <p class="text-xl font-mono text-purple-400 mt-1">-- GB</p>
            <p class="text-xs text-gray-500 mt-1">used / total</p>
        </div>
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-xs text-gray-400 uppercase tracking-wide">Disk</h2>
            <p class="text-xl font-mono text-yellow-400 mt-1">-- GB</p>
            <p class="text-xs text-gray-500 mt-1">free</p>
        </div>
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-xs text-gray-400 uppercase tracking-wide">Network</h2>
            <p class="text-xl font-mono text-green-400 mt-1">-- Mbps</p>
            <p class="text-xs text-gray-500 mt-1">throughput</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="md:col-span-2 bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-lg font-semibold text-blue-400 mb-3">Evaluation Scores</h2>
            <canvas id="evalChart" class="w-full h-64"></canvas>
        </div>
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-lg font-semibold text-blue-400 mb-3">Activity Feed</h2>
            <div id="activity-feed" class="space-y-2 max-h-64 overflow-y-auto" hx-get="/api/metrics/dashboard" hx-trigger="load, every 5s" hx-swap="innerHTML">
                <div class="bg-gray-750 rounded p-2 text-xs border border-gray-700">
                    <span class="text-gray-500">Loading activity...</span>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
        <h2 class="text-lg font-semibold text-blue-400 mb-3">Model Provider Status</h2>
        <div id="provider-status" hx-get="/api/metrics/dashboard" hx-trigger="load, every 10s" hx-swap="innerHTML">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-gray-400 border-b border-gray-700">
                        <th class="text-left py-2">Provider</th>
                        <th class="text-left py-2">Model</th>
                        <th class="text-left py-2">Status</th>
                        <th class="text-left py-2">Latency</th>
                        <th class="text-left py-2">Tokens Used</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td colspan="5" class="py-4 text-center text-gray-500">Awaiting provider data...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
(function() {
    const ctx = document.getElementById('evalChart');
    if (!ctx) return;
    new Chart(ctx, {
        type: 'radar',
        data: {
            labels: ['Reasoning', 'Planning', 'Memory', 'Learning', 'Creativity', 'Safety'],
            datasets: [{
                label: 'Current',
                data: [0.78, 0.65, 0.82, 0.71, 0.69, 0.88],
                backgroundColor: 'rgba(59,130,246,0.2)',
                borderColor: 'rgba(59,130,246,1)',
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: { r: { min: 0, max: 1, ticks: { color: '#9ca3af', backdropColor: 'transparent' }, grid: { color: '#374151' }, pointLabels: { color: '#9ca3af' } } },
            plugins: { legend: { display: false } }
        }
    });
})();
</script>
