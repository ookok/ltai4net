<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LTAI Living Tree</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/htmx.org@1.9.10/dist/htmx.min.js" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@1.9.10/dist/htmx.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen">
    <nav class="bg-gray-800 border-b border-gray-700 px-4 py-2 flex gap-4 text-sm">
        <a href="/templates/living" class="hover:text-green-400" hx-boost="true">Living</a>
        <a href="/templates/dashboard" class="hover:text-green-400" hx-boost="true">Dashboard</a>
        <a href="/templates/admin" class="hover:text-green-400" hx-boost="true">Admin</a>
        <a href="/templates/canvas" class="hover:text-green-400" hx-boost="true">Canvas</a>
        <a href="/templates/knowledge" class="hover:text-green-400" hx-boost="true">Knowledge</a>
        <a href="/templates/task-tree" class="hover:text-green-400" hx-boost="true">Tasks</a>
        <a href="/templates/awakening" class="hover:text-green-400" hx-boost="true">Awakening</a>
    </nav>
    <main class="p-4">
        @RenderBody()
    </main>
</body>
</html>
