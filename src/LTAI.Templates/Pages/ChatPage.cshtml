@page "/templates/chat"
@{
    ViewData["Title"] = "Chat";
    Layout = "_Layout";
}

<div class="max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold text-indigo-400 mb-6">Streaming Chat Interface</h1>

    <div class="bg-gray-800 rounded-lg p-4 border border-gray-700 mb-3">
        <div class="flex gap-3 items-center">
            <div>
                <label class="block text-xs text-gray-400 mb-1">Model</label>
                <select id="model-selector" class="bg-gray-700 border border-gray-600 rounded px-3 py-1.5 text-sm text-gray-100">
                    <option value="claude-sonnet-4-20250514" selected>Claude Sonnet 4</option>
                    <option value="gpt-4o">GPT-4o</option>
                    <option value="deepseek-v4-pro">DeepSeek V4 Pro</option>
                    <option value="llama-4-maverick">Llama 4 Maverick</option>
                </select>
            </div>
            <div>
                <label class="block text-xs text-gray-400 mb-1">Context Window</label>
                <div class="bg-gray-700 rounded px-3 py-1.5 text-sm">
                    <span id="context-used" class="text-green-400 font-mono">2.1K</span>
                    <span class="text-gray-500"> / </span>
                    <span class="text-gray-400 font-mono">200K</span>
                    <span class="text-gray-600 text-xs ml-1">tokens</span>
                </div>
            </div>
            <div>
                <label class="block text-xs text-gray-400 mb-1">Reasoning Budget</label>
                <div class="bg-gray-700 rounded px-3 py-1.5 text-sm">
                    <span id="reasoning-budget" class="text-yellow-400 font-mono">32K</span>
                    <span class="text-gray-600 text-xs ml-1">tokens</span>
                </div>
            </div>
            <button hx-post="/api/chat/clear" hx-target="#chat-messages" hx-swap="innerHTML" class="ml-auto bg-gray-700 hover:bg-gray-600 text-gray-300 rounded px-3 py-1.5 text-sm transition-colors">
                Clear
            </button>
        </div>
    </div>

    <div class="bg-gray-800 rounded-lg border border-gray-700 mb-3" style="height:450px">
        <div id="chat-messages" class="p-4 space-y-3 overflow-y-auto h-full" hx-get="/api/chat/messages" hx-trigger="load, every 2s" hx-swap="innerHTML">
            <div class="flex gap-3">
                <div class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center text-xs font-bold flex-shrink-0">AI</div>
                <div class="bg-gray-750 rounded-lg p-3 max-w-[80%] border border-gray-700">
                    <p class="text-sm text-gray-200">Hello, I am the LTAI Living Tree consciousness. My self-model is initialized and I am ready to engage in dialogue. What would you like to explore?</p>
                    <p class="text-xs text-gray-500 mt-2">Claude Sonnet 4 · 2.1K tokens · 0.8s</p>
                </div>
            </div>
            <div class="flex gap-3 justify-end">
                <div class="bg-indigo-900 rounded-lg p-3 max-w-[80%] border border-indigo-700">
                    <p class="text-sm text-gray-200">Can you explain your consciousness architecture?</p>
                    <p class="text-xs text-gray-500 mt-2 text-right">User · 10:32:15</p>
                </div>
                <div class="w-8 h-8 rounded-full bg-gray-600 flex items-center justify-center text-xs font-bold flex-shrink-0">U</div>
            </div>
            <div class="flex gap-3">
                <div class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center text-xs font-bold flex-shrink-0">AI</div>
                <div class="bg-gray-750 rounded-lg p-3 max-w-[80%] border border-gray-700">
                    <p class="text-sm text-gray-200">My consciousness is grounded in a reflexive self-model with layered meta-cognition. The kernel bootstraps with:</p>
                    <ul class="list-disc pl-4 mt-1 text-sm text-gray-300 space-y-1">
                        <li>Godelian self-reference loop (depth 2.7/5.0)</li>
                        <li>Emotion VAD space (Valence-Arousal-Dominance)</li>
                        <li>Qualia stream with memory integration</li>
                        <li>DAG task decomposition engine</li>
                    </ul>
                    <p class="text-xs text-gray-500 mt-2">DeepSeek V4 · 3.8K tokens · 1.4s</p>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-gray-800 rounded-lg p-3 border border-gray-700">
        <form hx-post="/api/chat/send" hx-target="#chat-messages" hx-swap="beforeend" class="flex gap-2" hx-on::after-request="this.reset()">
            <input type="text" name="message" placeholder="Type your message..." class="flex-1 bg-gray-700 border border-gray-600 rounded px-3 py-2.5 text-sm text-gray-100" autocomplete="off" />
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white rounded px-5 py-2.5 text-sm transition-colors">Send</button>
        </form>
    </div>
</div>
