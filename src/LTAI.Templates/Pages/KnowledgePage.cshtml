@page "/templates/knowledge"
@{
    ViewData["Title"] = "Knowledge";
    Layout = "_Layout";
}

<div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-purple-400 mb-6">Knowledge Graph</h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="md:col-span-2 bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-lg font-semibold text-purple-400 mb-3">Vector Search</h2>
            <form hx-post="/api/knowledge/search" hx-target="#search-results" hx-swap="innerHTML" class="flex gap-2">
                <input type="text" name="query" placeholder="Search knowledge base..." class="flex-1 bg-gray-700 border border-gray-600 rounded px-3 py-2 text-sm text-gray-100" autocomplete="off" />
                <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white rounded px-4 py-2 text-sm transition-colors">Search</button>
            </form>
            <div id="search-results" class="mt-3 space-y-2 max-h-64 overflow-y-auto">
                <p class="text-xs text-gray-500">Enter a query to search the vector store.</p>
            </div>
        </div>
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
            <h2 class="text-lg font-semibold text-purple-400 mb-3">Document Store Stats</h2>
            <div id="doc-stats" hx-get="/api/knowledge/stats" hx-trigger="load, every 10s" hx-swap="innerHTML">
                <div class="space-y-3">
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-400">Total Documents</span>
                        <span class="text-purple-400 font-mono">--</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-400">Total Chunks</span>
                        <span class="text-purple-400 font-mono">--</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-400">Vector Dimension</span>
                        <span class="text-purple-400 font-mono">1536</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-400">Index Type</span>
                        <span class="text-purple-400 font-mono">HNSW</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-gray-800 rounded-lg p-4 border border-gray-700 mb-6">
        <h2 class="text-lg font-semibold text-purple-400 mb-3">Knowledge Graph Visualization</h2>
        <canvas id="kgChart" class="w-full h-72"></canvas>
    </div>

    <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
        <h2 class="text-lg font-semibold text-purple-400 mb-3">Recent Documents</h2>
        <div id="recent-docs" class="space-y-2" hx-get="/api/knowledge/recent" hx-trigger="load, every 5s" hx-swap="innerHTML">
            <div class="bg-gray-750 rounded p-3 border border-gray-700 flex items-center gap-3">
                <div class="w-2 h-2 bg-purple-400 rounded-full"></div>
                <div class="flex-1">
                    <p class="text-sm">Loading recent documents...</p>
                    <p class="text-xs text-gray-500">Fetching from document store</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    const ctx = document.getElementById('kgChart');
    if (!ctx) return;
    new Chart(ctx, {
        type: 'scatter',
        data: {
            datasets: [{
                label: 'Documents',
                data: [
                    {x: 0.8, y: 0.6}, {x: 0.4, y: 0.9}, {x: 0.7, y: 0.3},
                    {x: 0.2, y: 0.5}, {x: 0.9, y: 0.7}, {x: 0.5, y: 0.2},
                    {x: 0.3, y: 0.8}, {x: 0.6, y: 0.4}, {x: 0.1, y: 0.1}
                ],
                backgroundColor: 'rgba(168,85,247,0.6)',
                borderColor: 'rgba(168,85,247,1)',
                pointRadius: 6
            }, {
                label: 'Concepts',
                data: [
                    {x: 0.5, y: 0.5}, {x: 0.6, y: 0.7}, {x: 0.3, y: 0.4}
                ],
                backgroundColor: 'rgba(34,211,238,0.6)',
                borderColor: 'rgba(34,211,238,1)',
                pointRadius: 8,
                pointStyle: 'triangle'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: { min: 0, max: 1, ticks: { color: '#9ca3af' }, grid: { color: '#374151' } },
                y: { min: 0, max: 1, ticks: { color: '#9ca3af' }, grid: { color: '#374151' } }
            },
            plugins: { legend: { labels: { color: '#9ca3af' } } }
        }
    });
})();
</script>
