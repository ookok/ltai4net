@page "/templates/canvas"
@{
    ViewData["Title"] = "Mind Canvas";
    Layout = "_Layout";
}

<div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-cyan-400 mb-6">Mind Space Visualization</h1>

    <div class="bg-gray-800 rounded-lg p-4 border border-gray-700 mb-6">
        <div class="flex gap-2 mb-3">
            <button class="bg-cyan-700 hover:bg-cyan-600 text-white rounded px-3 py-1 text-sm transition-colors" onclick="resetView()">Reset View</button>
            <button class="bg-gray-700 hover:bg-gray-600 text-gray-200 rounded px-3 py-1 text-sm transition-colors" hx-get="/api/canvas/entities" hx-target="#entity-list" hx-swap="innerHTML">Refresh Entities</button>
            <span class="ml-auto text-xs text-gray-500 self-center">Nodes shown in real-time</span>
        </div>
        <div class="relative bg-gray-900 rounded border border-gray-700 overflow-hidden" style="height:500px">
            <svg id="mind-canvas" class="w-full h-full" viewBox="0 0 800 500">
                <defs>
                    <radialGradient id="nodeGrad">
                        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.8" />
                        <stop offset="100%" stop-color="#0891b2" stop-opacity="0.3" />
                    </radialGradient>
                    <radialGradient id="activeGrad">
                        <stop offset="0%" stop-color="#4ade80" stop-opacity="0.9" />
                        <stop offset="100%" stop-color="#166534" stop-opacity="0.4" />
                    </radialGradient>
                </defs>
                <g class="edges">
                    <line x1="400" y1="250" x2="200" y2="120" stroke="#374151" stroke-width="1.5" stroke-dasharray="4,3" />
                    <line x1="400" y1="250" x2="600" y2="120" stroke="#374151" stroke-width="1.5" stroke-dasharray="4,3" />
                    <line x1="400" y1="250" x2="150" y2="380" stroke="#374151" stroke-width="1.5" stroke-dasharray="4,3" />
                    <line x1="400" y1="250" x2="650" y2="380" stroke="#374151" stroke-width="1.5" stroke-dasharray="4,3" />
                    <line x1="400" y1="250" x2="400" y2="60" stroke="#374151" stroke-width="1.5" stroke-dasharray="4,3" />
                    <line x1="200" y1="120" x2="300" y2="180" stroke="#374151" stroke-width="1" />
                    <line x1="600" y1="120" x2="500" y2="180" stroke="#374151" stroke-width="1" />
                    <line x1="150" y1="380" x2="300" y2="320" stroke="#374151" stroke-width="1" />
                    <line x1="650" y1="380" x2="500" y2="320" stroke="#374151" stroke-width="1" />
                </g>
                <g class="nodes">
                    <circle cx="400" cy="250" r="28" fill="url(#nodeGrad)" stroke="#22d3ee" stroke-width="2" class="cursor-pointer" />
                    <text x="400" y="255" text-anchor="middle" fill="#fff" font-size="9" font-family="monospace">Self</text>

                    <circle cx="200" cy="120" r="22" fill="url(#nodeGrad)" stroke="#67e8f9" stroke-width="1.5" class="cursor-pointer" />
                    <text x="200" y="124" text-anchor="middle" fill="#fff" font-size="8" font-family="monospace">Perception</text>

                    <circle cx="600" cy="120" r="22" fill="url(#nodeGrad)" stroke="#67e8f9" stroke-width="1.5" class="cursor-pointer" />
                    <text x="600" y="124" text-anchor="middle" fill="#fff" font-size="8" font-family="monospace">Reasoning</text>

                    <circle cx="150" cy="380" r="20" fill="url(#activeGrad)" stroke="#4ade80" stroke-width="2" class="cursor-pointer">
                        <animate attributeName="r" values="20;23;20" dur="2s" repeatCount="indefinite" />
                    </circle>
                    <text x="150" y="384" text-anchor="middle" fill="#fff" font-size="7" font-family="monospace">Memory</text>

                    <circle cx="650" cy="380" r="20" fill="url(#nodeGrad)" stroke="#67e8f9" stroke-width="1.5" class="cursor-pointer" />
                    <text x="650" y="384" text-anchor="middle" fill="#fff" font-size="7" font-family="monospace">Planning</text>

                    <circle cx="400" cy="60" r="18" fill="url(#nodeGrad)" stroke="#67e8f9" stroke-width="1.5" class="cursor-pointer" />
                    <text x="400" y="64" text-anchor="middle" fill="#fff" font-size="7" font-family="monospace">Consciousness</text>

                    <circle cx="300" cy="180" r="14" fill="url(#nodeGrad)" stroke="#67e8f9" stroke-width="1" class="cursor-pointer" />
                    <text x="300" y="184" text-anchor="middle" fill="#fff" font-size="6" font-family="monospace">Qualia</text>

                    <circle cx="500" cy="180" r="14" fill="url(#nodeGrad)" stroke="#67e8f9" stroke-width="1" class="cursor-pointer" />
                    <text x="500" y="184" text-anchor="middle" fill="#fff" font-size="6" font-family="monospace">Attention</text>

                    <circle cx="300" cy="320" r="12" fill="url(#nodeGrad)" stroke="#67e8f9" stroke-width="1" />
                    <text x="300" y="324" text-anchor="middle" fill="#fff" font-size="6" font-family="monospace">Agent</text>

                    <circle cx="500" cy="320" r="12" fill="url(#nodeGrad)" stroke="#67e8f9" stroke-width="1" />
                    <text x="500" y="324" text-anchor="middle" fill="#fff" font-size="6" font-family="monospace">Tool</text>
                </g>
                <g class="activity-bubbles">
                    <circle cx="320" cy="140" r="3" fill="#4ade80" opacity="0.7">
                        <animate attributeName="opacity" values="0.7;0.1;0.7" dur="1.5s" repeatCount="indefinite" />
                    </circle>
                    <circle cx="480" cy="140" r="3" fill="#facc15" opacity="0.7">
                        <animate attributeName="opacity" values="0.7;0.1;0.7" dur="2.3s" repeatCount="indefinite" />
                    </circle>
                    <circle cx="250" cy="300" r="3" fill="#a78bfa" opacity="0.7">
                        <animate attributeName="opacity" values="0.7;0.1;0.7" dur="1.8s" repeatCount="indefinite" />
                    </circle>
                    <circle cx="550" cy="300" r="3" fill="#f472b6" opacity="0.7">
                        <animate attributeName="opacity" values="0.7;0.1;0.7" dur="2.1s" repeatCount="indefinite" />
                    </circle>
                    <circle cx="400" cy="200" r="3" fill="#38bdf8" opacity="0.7">
                        <animate attributeName="opacity" values="0.7;0.1;0.7" dur="1.2s" repeatCount="indefinite" />
                    </circle>
                </g>
            </svg>
        </div>
    </div>

    <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
        <h2 class="text-lg font-semibold text-cyan-400 mb-3">Entity Graph</h2>
        <div id="entity-list" class="space-y-2 max-h-48 overflow-y-auto" hx-get="/api/canvas/entities" hx-trigger="load, every 5s" hx-swap="innerHTML">
            <div class="bg-gray-750 rounded p-3 border border-gray-700 flex items-center gap-3">
                <div class="w-3 h-3 bg-cyan-400 rounded-full animate-pulse"></div>
                <div>
                    <p class="text-sm">Loading entity graph...</p>
                    <p class="text-xs text-gray-500">Awaiting connection to mind space</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function resetView() {
    const svg = document.getElementById('mind-canvas');
    svg.setAttribute('viewBox', '0 0 800 500');
}
</script>
