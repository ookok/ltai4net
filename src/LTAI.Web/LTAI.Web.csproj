<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LTAI.Web</RootNamespace>
    <IsExeProject>true</IsExeProject>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\dist\build\Web\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- NativeAOT (LTS) -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcInstructionSet>native</IlcInstructionSet>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <IlcDisableUnhandledExceptionExperience>true</IlcDisableUnhandledExceptionExperience>
    <IlcTreatLinkingErrorsAsWarnings>true</IlcTreatLinkingErrorsAsWarnings>
    <NoWarn>$(NoWarn);IL2026;IL3050;IL2046;IL2091;IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LTAI.Core\LTAI.Core.csproj" />
    <ProjectReference Include="..\LTAI.AI\LTAI.AI.csproj" />
    <ProjectReference Include="..\LTAI.Agent\LTAI.Agent.csproj" />
    <!-- P6: MAF protocol packages (prebuilt DLL support) -->
    <Reference Include="Microsoft.Agents.AI.Abstractions"             HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Abstractions.dll"             Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Abstractions.dll')" />
    <Reference Include="Microsoft.Agents.AI"                          HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.dll"                          Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.dll')" />
    <Reference Include="Microsoft.Agents.AI.Hosting.AspNetCore"      HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.AspNetCore.dll"      Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.AspNetCore.dll')" />
    <Reference Include="Microsoft.Agents.AI.Hosting.A2A"              HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.A2A.dll"              Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.A2A.dll')" />
    <Reference Include="Microsoft.Agents.AI.Hosting.A2A.AspNetCore"   HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.A2A.AspNetCore.dll"   Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.A2A.AspNetCore.dll')" />
    <Reference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore"  HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.AGUI.AspNetCore.dll"  Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.AGUI.AspNetCore.dll')" />
    <Reference Include="Microsoft.Agents.AI.Hosting.OpenAI"          HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.OpenAI.dll"          Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.OpenAI.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.Hosting.AspNetCore\Microsoft.Agents.AI.Hosting.AspNetCore.csproj"    Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.AspNetCore.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.Hosting.A2A\Microsoft.Agents.AI.Hosting.A2A.csproj"                Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.A2A.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.Hosting.A2A.AspNetCore\Microsoft.Agents.AI.Hosting.A2A.AspNetCore.csproj" Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.A2A.AspNetCore.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.Hosting.AGUI.AspNetCore\Microsoft.Agents.AI.Hosting.AGUI.AspNetCore.csproj" Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.AGUI.AspNetCore.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.Hosting.OpenAI\Microsoft.Agents.AI.Hosting.OpenAI.csproj"          Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.OpenAI.dll')" />
    <!-- P7.1: MAF DevUI — Sdk.Web with frontend assets, always use ProjectReference -->
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.DevUI\Microsoft.Agents.AI.DevUI.csproj" />
  </ItemGroup>

  <!-- NativeAOT linker descriptor -->
  <ItemGroup>
    <RdXmlFile Include="..\..\aot\rd.xml" />
  </ItemGroup>

</Project>
