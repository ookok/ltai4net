{
  "LTAI": {
    "AI": {
      "DefaultProvider": "deepseek",
      "MaxTokens": 4096,
      "Temperature": 0.3,
      "SkipSafetyChecks": false,
      "GlobalTokenBudget": 1000000,
      "PerUserTokenBudget": 200000
    },
    "Web": {
      "Port": 5100,
      "CorsOrigins": ["http://localhost:5173", "http://localhost:3000"]
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}
