<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LTAI.CLI</RootNamespace>
    <IsExeProject>true</IsExeProject>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\dist\Cli\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LTAI.Core\LTAI.Core.csproj" />
    <ProjectReference Include="..\LTAI.AI\LTAI.AI.csproj" />
    <ProjectReference Include="..\LTAI.Agent\LTAI.Agent.csproj" />
  </ItemGroup>


  <!-- 应用图标 (SVG source; convert to .ico for Windows .exe: https://convertio.co/svg-ico/) -->
  <ItemGroup>
    <Content Include="Assets/ltai-cli.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
