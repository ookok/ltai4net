<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LTAI.Agent</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="Markdig" Version="1.2.0" />
    <!-- ── MAF prebuild support: if dist/lib/maf/*.dll exists, use Reference instead of ProjectReference (faster build). ── -->
    <Reference Include="Microsoft.Agents.AI.Abstractions" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Abstractions.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Abstractions.dll')" />
    <Reference Include="Microsoft.Agents.AI" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.dll')" />
    <Reference Include="Microsoft.Agents.AI.OpenAI" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.OpenAI.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.OpenAI.dll')" />
    <Reference Include="Microsoft.Agents.AI.Tools.Shell" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Tools.Shell.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Tools.Shell.dll')" />
    <Reference Include="Microsoft.Agents.AI.Workflows" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Workflows.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Workflows.dll')" />
    <Reference Include="Microsoft.Agents.AI.Workflows.Declarative" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Workflows.Declarative.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Workflows.Declarative.dll')" />
    <Reference Include="Microsoft.Agents.AI.Workflows.Declarative.Mcp" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Workflows.Declarative.Mcp.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Workflows.Declarative.Mcp.dll')" />
    <Reference Include="Microsoft.Agents.AI.Harness" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Harness.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Harness.dll')" />
    <Reference Include="Microsoft.Agents.AI.Hosting" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.dll')" />
    <Reference Include="Microsoft.Agents.AI.Mem0" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Mem0.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Mem0.dll')" />
    <Reference Include="Microsoft.Agents.AI.Mcp" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Mcp.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Mcp.dll')" />
    <Reference Include="Microsoft.Agents.AI.DurableTask" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.DurableTask.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.DurableTask.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI\Microsoft.Agents.AI.csproj" Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.OpenAI\Microsoft.Agents.AI.OpenAI.csproj" Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.OpenAI.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.Tools.Shell\Microsoft.Agents.AI.Tools.Shell.csproj" Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Tools.Shell.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.Workflows\Microsoft.Agents.AI.Workflows.csproj" Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Workflows.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.Workflows.Declarative\Microsoft.Agents.AI.Workflows.Declarative.csproj" Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Workflows.Declarative.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.Workflows.Declarative.Mcp\Microsoft.Agents.AI.Workflows.Declarative.Mcp.csproj" Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Workflows.Declarative.Mcp.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.Harness\Microsoft.Agents.AI.Harness.csproj" Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Harness.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.Hosting\Microsoft.Agents.AI.Hosting.csproj" Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Hosting.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.Mem0\Microsoft.Agents.AI.Mem0.csproj" Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Mem0.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.Mcp\Microsoft.Agents.AI.Mcp.csproj" Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Mcp.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.DurableTask\Microsoft.Agents.AI.DurableTask.csproj" Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.DurableTask.dll')" />
    <PackageReference Include="Microsoft.DurableTask.InProcessTestHost" Version="0.2.3-preview.1" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageReference Include="System.ClientModel" Version="1.14.0" />

    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <!-- LiteDB removed — replaced by KgStore (SQLite FTS5 + CTE) -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Wasmtime" Version="44.0.0" />
    <PackageReference Include="TurboQuant" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LTAI.Core\LTAI.Core.csproj" />
    <ProjectReference Include="..\LTAI.AI\LTAI.AI.csproj" />
    <ProjectReference Include="..\LTAI.Hpo\LTAI.Hpo.csproj" />
    <ProjectReference Include="..\LTAI.Mm\LTAI.Mm.csproj" />
    <ProjectReference Include="..\LTAI.Agent.Documents\LTAI.Agent.Documents.csproj" />
    <ProjectReference Include="..\LTAI.Agent.Database\LTAI.Agent.Database.csproj" />
    <ProjectReference Include="..\LTAI.Agent.CodeAnalysis\LTAI.Agent.CodeAnalysis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- P7.5: MAF Workflows.Declarative YAML files (greeting fast-path) -->
    <None Include="Workflows\ltai-workflows\**\*.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ltai-workflows\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <!-- P15: LTAI hot-editable workflow configs (JSON, parsed by System.Text.Json) -->
    <None Include="Workflows\ltai-workflows\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ltai-workflows\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
