<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsExeProject>true</IsExeProject>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\dist\TUI\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LTAI.TUI</RootNamespace>
    <PublishReadyToRun>true</PublishReadyToRun>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PrettyPrompt" Version="4.1.1" />
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
    <PackageReference Include="TextCopy" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LTAI.Core\LTAI.Core.csproj" />
    <ProjectReference Include="..\LTAI.AI\LTAI.AI.csproj" />


    <ProjectReference Include="..\LTAI.Agent\LTAI.Agent.csproj" />
  </ItemGroup>


  <!-- 应用图标 -->
  <ItemGroup>
    <Content Include="Assets/ltai-tui.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Alacritty 终端嵌入为资源 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Alacritty\alacritty.exe" />
    <EmbeddedResource Include="Assets\Alacritty\alacritty.yml" />
  </ItemGroup>

</Project>
