@page "/knowledge"
@inject LTAI.Vector.Knowledge.DocumentStore DocStore
@inject LTAI.Vector.Knowledge.KnowledgeBase KB

<PageTitle>Knowledge — LTAI</PageTitle>
<h2>Knowledge Base</h2>
<p class="muted">Documents indexed: @_docCount | Press Search to query</p>

<div class="search-bar">
    <input @bind="SearchQuery" placeholder="Search knowledge..." @onkeydown="OnSearchKey" />
    <button @onclick="DoSearch">🔍 Search</button>
</div>

@if (_results.Count > 0)
{
    <div class="results">
        @foreach (var r in _results)
        {
            <div class="card result-item">
                <strong>@r.Id</strong>
                <p>@r.Text?[..Math.Min(r.Text?.Length ?? 0, 200)]</p>
                <span class="score">Score: @r.Score.ToString("F2")</span>
            </div>
        }
    </div>
}

@code {
    private string SearchQuery = "";
    private int _docCount;
    private List<LTAI.Vector.Models.VectorSearchResult> _results = new();

    protected override async Task OnInitializedAsync()
    {
        try { _docCount = (await DocStore.GetStats()).TotalDocuments; } catch { _docCount = 0; }
    }

    private async Task OnSearchKey(KeyboardEventArgs e) { if (e.Key == "Enter") await DoSearch(); }
    private async Task DoSearch()
    {
        if (string.IsNullOrWhiteSpace(SearchQuery)) return;
        var results = await KB.SearchAsync(SearchQuery, 10);
        _results = results.Select(r => new LTAI.Vector.Models.VectorSearchResult { Id = r.Id, Text = r.Text, Score = r.Score }).ToList();
    }
}
