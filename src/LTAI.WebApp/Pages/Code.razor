@page "/code"
@inject MultiLangCodeAnalyzer Analyzer
@inject CodeReviewEngine Review
@inject LTAI.Core.Governors.IMicroKernel? Kernel

<PageTitle>Code — LTAI V1.0</PageTitle>
<h2>Code Tools</h2>

<div class="tabs">
    <button class="tab @(_tab == "analyze" ? "active" : "")" @onclick="SetAnalyzeTab">Analyze</button>
    <button class="tab @(_tab == "review" ? "active" : "")" @onclick="SetReviewTab">Review</button>
    <button class="tab @(_tab == "build" ? "active" : "")" @onclick="SetBuildTab">Build</button>
    <button class="tab @(_tab == "editor" ? "active" : "")" @onclick="SetEditorTab">Editor</button>
    <span style="margin-left:auto" class="muted">@_statusLine</span>
</div>

@if (_tab == "analyze")
{
    <div class="card">
        <h3>Analyze Code</h3>
        <textarea @bind="CodeInput" rows="12" placeholder="Paste code here..."></textarea>
        <select @bind="LanguageInput">
            <option value="">Auto</option>
            @foreach (var l in Enum.GetNames<CodeLanguage>()) { <option value="@l">@l</option> }
        </select>
        <button @onclick="AnalyzeCodeAsync">Analyze</button>

        @if (_analysisResult != null)
        {
            <div class="results">
                <p>Language: @_analysisResult.LanguageName | Lines: @_analysisResult.TotalLines | Functions: @_analysisResult.Functions.Count | Complexity: @_analysisResult.Complexity</p>
            </div>
        }
    </div>
}
else if (_tab == "review")
{
    <div class="card">
        <h3>Code Review</h3>
        <button @onclick="RunReviewAsync">Review Staged Changes</button>
        @if (_reviewReport != null)
        {
            <p>Score: <strong>@_reviewReport.OverallScore:F0</strong>/100 — @_reviewReport.Summary</p>
            <p>Issues: @_reviewReport.TotalIssues (Critical: @_reviewReport.CriticalIssues | Warnings: @_reviewReport.Warnings | Info: @_reviewReport.Infos)</p>
        }
    </div>
}
else if (_tab == "build")
{
    <div class="card">
        <h3>Build and Run</h3>
        <input @bind="BuildCommand" placeholder="dotnet build" style="width:100%;margin-bottom:0.5rem" />
        <button @onclick="RunBuildAsync" disabled="@_building">@(_building ? "Building..." : "Build")</button>
        <button @onclick="RunTestAsync" disabled="@_building" style="margin-left:0.5rem">Test</button>
        @if (!string.IsNullOrEmpty(_buildOutput))
        {
            <h4>Output</h4>
            <pre class="build-output">@_buildOutput</pre>
        }
    </div>
}
else if (_tab == "editor")
{
    <div class="card">
        <h3>File Editor</h3>
        <div style="display:flex;gap:0.5rem;margin-bottom:0.5rem">
            <input @bind="EditorFilePath" placeholder="path/to/file.cs" style="flex:1" />
            <button @onclick="LoadFileAsync" class="sm">Load</button>
            <button @onclick="SaveFileAsync" class="sm" disabled="@(string.IsNullOrEmpty(EditorFilePath))">Save</button>
        </div>
        <textarea @bind="EditorContent" rows="20" placeholder="File content..." style="font-family:monospace;width:100%"></textarea>
    </div>
}

@code {
    private string _tab = "analyze";
    private string CodeInput = "";
    private string LanguageInput = "";
    private CodeAnalysisResult? _analysisResult;
    private ReviewReport? _reviewReport;
    private string BuildCommand = "dotnet build";
    private string _buildOutput = "";
    private bool _building;
    private string EditorFilePath = "";
    private string EditorContent = "";
    private string _statusLine = "";

    private void SetAnalyzeTab() => _tab = "analyze";
    private void SetReviewTab() => _tab = "review";
    private void SetBuildTab() => _tab = "build";
    private void SetEditorTab() => _tab = "editor";

    private async Task AnalyzeCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(CodeInput)) return;
        var lang = Enum.TryParse<CodeLanguage>(LanguageInput, out var l) ? l : CodeLanguage.Unknown;
        _analysisResult = await Analyzer.AnalyzeAsync(CodeInput, lang);
        _statusLine = $"Analyzed: {_analysisResult.Functions.Count} functions";
    }

    private async Task RunReviewAsync()
    {
        _reviewReport = await Review.ReviewAsync();
        _statusLine = $"Review: {_reviewReport.OverallScore:F0}/100";
    }

    private async Task RunBuildAsync()
    {
        _building = true;
        _buildOutput = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            if (Kernel != null)
            {
                var result = await Kernel.ExecuteAsync(new LTAI.Core.Governors.KernelOp
                {
                    Command = "dotnet", Arguments = "build --no-restore",
                    Timeout = TimeSpan.FromMinutes(2)
                });
                _buildOutput = result.Success ? result.Data : result.Error;
                _statusLine = result.Success ? "Build: OK" : "Build: FAILED";
            }
            else
            {
                var proc = System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                {
                    FileName = "dotnet", Arguments = "build --no-restore",
                    RedirectStandardOutput = true, RedirectStandardError = true,
                    UseShellExecute = false, CreateNoWindow = true
                });
                if (proc != null)
                {
                    _buildOutput = proc.StandardOutput.ReadToEnd() + "\n" + proc.StandardError.ReadToEnd();
                    await proc.WaitForExitAsync();
                    _statusLine = proc.ExitCode == 0 ? "Build: OK" : $"Build: exit {proc.ExitCode}";
                }
            }
        }
        catch (Exception ex) { _buildOutput = ex.Message; _statusLine = "Build: ERROR"; }
        finally { _building = false; }
    }

    private async Task RunTestAsync()
    {
        _building = true;
        _buildOutput = "";
        await InvokeAsync(StateHasChanged);
        try
        {
            var proc = System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName = "dotnet", Arguments = "test --no-build --nologo",
                RedirectStandardOutput = true, RedirectStandardError = true,
                UseShellExecute = false, CreateNoWindow = true
            });
            if (proc != null)
            {
                _buildOutput = proc.StandardOutput.ReadToEnd() + "\n" + proc.StandardError.ReadToEnd();
                await proc.WaitForExitAsync();
                _statusLine = proc.ExitCode == 0 ? "Tests: PASS" : "Tests: FAIL";
            }
        }
        catch (Exception ex) { _buildOutput = ex.Message; _statusLine = "Tests: ERROR"; }
        finally { _building = false; }
    }

    private async Task LoadFileAsync()
    {
        if (string.IsNullOrEmpty(EditorFilePath)) return;
        var path = EditorFilePath;
        if (!File.Exists(path)) path = Path.Combine(Directory.GetCurrentDirectory(), EditorFilePath);
        if (File.Exists(path))
        {
            EditorContent = await File.ReadAllTextAsync(path);
            EditorFilePath = path;
            _statusLine = $"Loaded: {Path.GetFileName(path)} ({EditorContent.Length}B)";
        }
    }

    private async Task SaveFileAsync()
    {
        if (string.IsNullOrEmpty(EditorFilePath) || string.IsNullOrEmpty(EditorContent)) return;
        await File.WriteAllTextAsync(EditorFilePath, EditorContent);
        _statusLine = $"Saved: {Path.GetFileName(EditorFilePath)} ({EditorContent.Length}B)";
    }
}
