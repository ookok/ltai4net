@page "/git"

<PageTitle>Git — LTAI</PageTitle>
<h2>Git Overview</h2>

<div class="grid-2">
    <div class="card">
        <h3>Status</h3>
        <pre class="code-view"><code>@_status</code></pre>
        <button @onclick="Refresh" class="sm">🔄 Refresh</button>
    </div>

    <div class="card">
        <h3>Recent Commits</h3>
        <pre class="code-view"><code>@_log</code></pre>
    </div>
</div>

<div class="card" style="margin-top:1rem">
    <h3>Branch</h3>
    <p>@_branch</p>
</div>

@code {
    private string _status = "";
    private string _log = "";
    private string _branch = "";

    protected override void OnInitialized() => Refresh();

    private void Refresh()
    {
        _status = RunGit("status --short");
        _log = RunGit("log --oneline -15");
        _branch = RunGit("branch --show-current").Trim();
        if (string.IsNullOrWhiteSpace(_status)) _status = "Working tree clean";
    }

    private static string RunGit(string args)
    {
        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo("git", args)
            {
                RedirectStandardOutput = true, RedirectStandardError = true,
                UseShellExecute = false, CreateNoWindow = true
            };
            using var p = System.Diagnostics.Process.Start(psi);
            return p?.StandardOutput.ReadToEnd() ?? "git not available";
        }
        catch { return "git not available"; }
    }
}
