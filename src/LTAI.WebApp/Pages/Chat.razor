@page "/chat"
@using LTAI.Core.Governors
@inject LivingTreeSystem LTS
@inject CPSProcessingService? CPS
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Chat — LTAI V1.0</PageTitle>

<div class="chat-layout">
    <div class="chat-sidebar">
        <h3>Session</h3>
        <button @onclick="LoadPromptTemplate" class="sm">📋 Templates</button>
        @if (!_sending) {
            <button @onclick="SendAsync" class="sm primary" disabled="@(string.IsNullOrWhiteSpace(Input))">▶ Send</button>
        } else {
            <button @onclick="AbortAsync" class="sm danger">⏹ Abort</button>
        }
        <div style="margin-top:0.5rem">
            <span class="muted">Turns: @_history.Count/2</span><br/>
            <span class="muted">Tokens: @_totalTokens</span><br/>
            <span class="muted">Route: @_lastRoute</span>
        </div>
    </div>

    <div class="chat-main">
        <div class="chat-messages" id="chatBox">
            @foreach (var msg in _history)
            {
                <div class="msg @msg.Role.ToLower()">
                    <strong>@msg.Role:</strong>
                    @if (msg.Role == "LTAI")
                    {
                        @RenderMarkdown(msg.Text)
                    }
                    else
                    {
                        <pre>@msg.Text</pre>
                    }
                </div>
            }
            @if (_streaming)
            {
                <div class="msg ltai">
                    <strong>LTAI:</strong>
                    <pre id="streamOutput">@_streamBuffer</pre>
                </div>
            }
        </div>

        <div class="chat-input">
            <div class="input-actions">
                <span class="muted">@_attachedFile @_diffLabel</span>
                @if (CPS != null)
                {
                    <button @onclick="ShowDecisionTrace" class="icon" title="Explain decision">🔍</button>
                }
            </div>
            <textarea @bind="Input" @bind:event="oninput" @onkeydown="OnKeyDown"
                placeholder="Type your message... (Shift+Enter for new line)"></textarea>
            <button @onclick="SendAsync" disabled="@(_sending || string.IsNullOrWhiteSpace(Input))">
                @(_sending ? "⏳" : "Send")
            </button>
        </div>
        @if (_showDecisionTrace && CPS != null)
        {
            <div class="decision-trace">
                <h4>🔍 Decision Trace</h4>
                <pre>@CPS.ExplainLastDecision()</pre>
                <button @onclick="() => _showDecisionTrace = false" class="sm">Close</button>
            </div>
        }
        @if (_diffContent != null && !_showDecisionTrace)
        {
            <div class="diff-preview">
                <h4>@_diffLabel</h4>
                <pre>@_diffContent</pre>
                <button @onclick="SaveGeneratedFile" class="sm">💾 Save</button>
            </div>
        }
    </div>
</div>

@code {
    private string Input = "";
    private bool _sending;
    private bool _streaming;
    private string _streamBuffer = "";
    private string _lastRoute = "?";
    private int _totalTokens;
    private string _attachedFile = "";
    private string? _diffContent = null;
    private string? _diffLabel;
    private string? _originalContent;
    private bool _showDecisionTrace;
    private string? _generatedFileContent;
    private readonly List<ChatMessage> _history = new();
    private CancellationTokenSource? _streamCts;

    private record ChatMessage(string Role, string Text, DateTime Time);

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendAsync();
            Input = "";
        }
    }

    private async Task SendAsync()
    {
        var query = ResolveInput();
        if (string.IsNullOrWhiteSpace(query) || _sending) return;
        Input = "";
        _sending = true;
        _streaming = true;
        _streamBuffer = "";
        _showDecisionTrace = false;
        _history.Add(new("You", query, DateTime.Now));
        await InvokeAsync(StateHasChanged);

        _streamCts = new CancellationTokenSource();
        try
        {
            using var http = new HttpClient();
            var json = System.Text.Json.JsonSerializer.Serialize(new { query });
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var request = new HttpRequestMessage(HttpMethod.Post, "/api/maf/stream") { Content = content };

            var response = await http.SendAsync(request, HttpCompletionOption.ResponseHeadersRead, _streamCts.Token);
            using var stream = await response.Content.ReadAsStreamAsync();
            using var reader = new StreamReader(stream);

            var fullResponse = new System.Text.StringBuilder();
            while (true)
            {
                var line = await reader.ReadLineAsync();
                if (line == null || line == "data: [DONE]") break;
                if (!line.StartsWith("data: ")) continue;

                var data = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, System.Text.Json.JsonElement>>(line[6..]);
                if (data != null)
                {
                    if (data.TryGetValue("text", out var t))
                    {
                        var token = t.GetString() ?? "";
                        fullResponse.Append(token);
                        _streamBuffer = RenderStreamContent(fullResponse.ToString());
                        _totalTokens++;
                    }
                    if (data.TryGetValue("route", out var r))
                        _lastRoute = r.GetString() ?? "?";
                }
                await InvokeAsync(StateHasChanged);
            }

            var final = fullResponse.ToString();
            _history.Add(new("LTAI", final, DateTime.Now));

            if (_originalContent != null)
            {
                var generated = ExtractCodeBlock(final);
                _generatedFileContent = generated;
                _diffLabel = $"Original: {_originalContent.Length}B → Generated: {generated.Length}B";
            }
        }
        catch (OperationCanceledException) { _history.Add(new("LTAI", "[aborted]", DateTime.Now)); }
        catch (Exception ex) { _history.Add(new("Error", ex.Message, DateTime.Now)); }
        finally
        {
            _streaming = false;
            _sending = false;
            _streamBuffer = "";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task AbortAsync()
    {
        _streamCts?.Cancel();
    }

    private void ShowDecisionTrace()
    {
        _showDecisionTrace = !_showDecisionTrace;
    }

    private async Task SaveGeneratedFile()
    {
        if (_generatedFileContent == null || _attachedFile == null) return;
        var outputPath = Path.ChangeExtension(_attachedFile, ".generated" + Path.GetExtension(_attachedFile));
        await File.WriteAllTextAsync(outputPath, _generatedFileContent);
    }

    private string ResolveInput()
    {
        var q = Input;
        if (q.StartsWith("@@"))
        {
            var dir = q[2..].Trim();
            if (!Directory.Exists(dir)) dir = Path.Combine(Directory.GetCurrentDirectory(), dir);
            if (Directory.Exists(dir))
            {
                var files = Directory.GetFiles(dir, "*.*", SearchOption.AllDirectories).Take(30);
                q = $"[Folder: {Path.GetFileName(dir)}]\n" + string.Join("\n", files.Select(f => Path.GetRelativePath(dir, f)));
            }
        }
        else if (q.StartsWith("@"))
        {
            var file = q[1..].Trim();
            if (!File.Exists(file)) file = Path.Combine(Directory.GetCurrentDirectory(), file);
            if (File.Exists(file))
            {
                _attachedFile = file;
                _originalContent = File.ReadAllText(file);
                var content = _originalContent[..Math.Min(_originalContent.Length, 5000)];
                q = $"[File: {_attachedFile}]\n```{Path.GetExtension(file).TrimStart('.')}\n{content}\n```\n\nAnalyze/edit this file.";
            }
        }
        return q;
    }

    private static string ExtractCodeBlock(string response)
    {
        var match = System.Text.RegularExpressions.Regex.Match(response, @"```(?:\w+)?\n([\s\S]*?)```");
        return match.Success ? match.Groups[1].Value : "";
    }

    private static string RenderStreamContent(string text)
    {
        text = text.Replace("**", "").Replace("`", "");
        text = System.Text.RegularExpressions.Regex.Replace(text, @"```(\w+)?\n", "[Code]\n");
        text = System.Text.RegularExpressions.Regex.Replace(text, @"^### (.+)$", "> $1", System.Text.RegularExpressions.RegexOptions.Multiline);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"^## (.+)$", ">> $1", System.Text.RegularExpressions.RegexOptions.Multiline);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"^# (.+)$", ">>> $1", System.Text.RegularExpressions.RegexOptions.Multiline);
        return text;
    }

    private static RenderFragment RenderMarkdown(string text) => builder =>
    {
        var lines = text.Split('\n');
        var inCode = false;
        foreach (var line in lines)
        {
            if (line.StartsWith("```")) { inCode = !inCode; continue; }
            if (inCode) { builder.AddMarkupContent(0, $"<pre class='code'>{System.Net.WebUtility.HtmlEncode(line)}</pre>"); continue; }

            var processed = line;
            processed = System.Text.RegularExpressions.Regex.Replace(processed, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
            processed = System.Text.RegularExpressions.Regex.Replace(processed, @"\*(.+?)\*", "<em>$1</em>");
            processed = System.Text.RegularExpressions.Regex.Replace(processed, @"`([^`]+)`", "<code>$1</code>");

            if (processed.StartsWith("### ")) processed = $"<h4>{processed[4..]}</h4>";
            else if (processed.StartsWith("## ")) processed = $"<h3>{processed[3..]}</h3>";
            else if (processed.StartsWith("# ")) processed = $"<h2>{processed[2..]}</h2>";
            else if (processed.StartsWith("- ")) processed = $"<li>{processed[2..]}</li>";

            builder.AddMarkupContent(0, processed);
        }
    };

    private int _templateIndex;

    private async Task LoadPromptTemplate()
    {
        var templates = new[] { "Code Review", "Refactor", "Generate Tests", "Document", "Explain", "Fix Bugs", "Optimize", "Add Error Handling" };
        var selected = templates[_templateIndex % templates.Length];
        _templateIndex++;
        Input = $"[Template: {selected}] ";
    }

    public async ValueTask DisposeAsync() { _streamCts?.Cancel(); _streamCts?.Dispose(); }
}
