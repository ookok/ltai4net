@page "/config"
@inject IConfiguration Configuration
@inject Microsoft.Extensions.Options.IOptions<LTAI.Core.Configuration.LTAIOptions> Options

<PageTitle>Config — LTAI</PageTitle>
<h2>LLM Configuration</h2>

<div class="card">
    <h3>Provider</h3>
    <div class="metric"><span>Provider</span><span class="val">@Options.Value.AI.Provider</span></div>
    <div class="metric"><span>Mode</span><span class="val">@Options.Value.AI.Mode</span></div>
</div>

<div class="card">
    <h3>L1 — Fast Model</h3>
    <div class="metric"><span>Model</span><span class="val">@Options.Value.AI.GetLayerConfig("fast").Model</span></div>
    <div class="metric"><span>Temperature</span><span class="val">@Options.Value.AI.DefaultTemperature</span></div>
</div>

<div class="card">
    <h3>L2 — Deep Model</h3>
    <div class="metric"><span>Model</span><span class="val">@Options.Value.AI.GetLayerConfig("deep").Model</span></div>
    <div class="metric"><span>Temperature</span><span class="val">@Options.Value.AI.DefaultTemperature</span></div>
</div>

<div class="card">
    <h3>Limits</h3>
    <div class="metric"><span>Max Tokens</span><span class="val">@Options.Value.AI.MaxTokens</span></div>
    <div class="metric"><span>Daily Budget</span><span class="val">$@Options.Value.AI.DailyBudgetUsd</span></div>
</div>
