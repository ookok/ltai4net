@page "/config"
@inject IConfiguration Config

<PageTitle>Config — LTAI</PageTitle>
<h2>System Configuration</h2>

<div class="card">
    <h3>LLM Providers</h3>
    <table>
        <tr><th>Provider</th><th>Model</th><th>Endpoint</th></tr>
        @foreach (var (key, val) in Config.GetSection("LTAI:AI:Providers").GetChildren().ToDictionary(c => c.Key, c => c))
        {
            <tr>
                <td>@key</td>
                <td>@val["Model"]</td>
                <td>@val["Endpoint"]</td>
            </tr>
        }
    </table>
</div>

<div class="card">
    <h3>Settings</h3>
    <div class="metric"><span>Deep Model</span><span class="val">@Config["LTAI:AI:DeepModel"]</span></div>
    <div class="metric"><span>Fast Model</span><span class="val">@Config["LTAI:AI:FastModel"]</span></div>
    <div class="metric"><span>Daily Budget</span><span class="val">$@Config["LTAI:AI:DailyBudgetUsd"]</span></div>
    <div class="metric"><span>Rate Limit</span><span class="val">@Config["LTAI:Web:RateLimitPerMinute"]/min</span></div>
</div>

<div class="card">
    <h3>Module Status</h3>
    <div class="metric"><span>DNA</span><span class="val green">Active</span></div>
    <div class="metric"><span>Reasoning</span><span class="val green">Active</span></div>
    <div class="metric"><span>Sandbox</span><span class="val green">Active</span></div>
    <div class="metric"><span>Metrics</span><span class="val green">Active</span></div>
    <div class="metric"><span>Multimodal</span><span class="val green">Active</span></div>
    <div class="metric"><span>Network</span><span class="val green">Active</span></div>
</div>
