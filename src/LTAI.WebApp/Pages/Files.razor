@page "/files"
@inject MultiLangCodeAnalyzer Analyzer

<PageTitle>Files — LTAI</PageTitle>
<h2>Project Files</h2>
<p class="muted">@_currentDir</p>

<div class="file-layout">
    <div class="file-tree">
        <h3>📁 @_rootName</h3>
        <div class="tree">
            @RenderTree(_rootDir!, 0)
        </div>
    </div>

    <div class="file-content">
        @if (_selectedFile != null)
        {
            <h3>@Path.GetFileName(_selectedFile)</h3>
            @if (_analysisResult != null)
            {
                <div class="analysis-bar">
                    <span>@_analysisResult.LanguageName</span>
                    <span>@_analysisResult.TotalLines lines</span>
                    <span>@_analysisResult.Functions.Count fn</span>
                    <span>@_analysisResult.Classes.Count cls</span>
                    <span>Cx: @_analysisResult.Complexity</span>
                </div>
            }
            <pre class="code-view"><code>@_fileContent</code></pre>
        }
        else
        {
            <p class="muted">Select a file to view and analyze</p>
        }
    </div>
</div>

@code {
    private string _currentDir = "";
    private string _rootName = "";
    private DirectoryInfo? _rootDir;
    private string? _selectedFile;
    private string _fileContent = "";
    private CodeAnalysisResult? _analysisResult;

    protected override void OnInitialized()
    {
        _currentDir = Directory.GetCurrentDirectory();
        _rootDir = new DirectoryInfo(_currentDir);
        _rootName = _rootDir.Name;
    }

    private RenderFragment RenderTree(DirectoryInfo dir, int depth) => builder =>
    {
        if (depth > 2) return;
        foreach (var sd in dir.GetDirectories().Where(d => !d.Name.StartsWith('.') && d.Name != "bin" && d.Name != "obj").Take(8))
        {
            builder.AddMarkupContent(0, $"<div style='padding-left:{depth*16}px' class='dir'>📁 {sd.Name}</div>");
            RenderTree(sd, depth + 1)(builder);
        }
        foreach (var f in dir.GetFiles().Take(20).OrderBy(x => x.Extension).ThenBy(x => x.Name))
        {
            var icon = f.Extension switch { ".cs" => "🟢", ".py" => "🐍", ".js" => "🟨", ".ts" => "🟦", ".md" => "📝", ".csproj" => "⚙", _ => "📄" };
            var path = f.FullName;
            builder.AddMarkupContent(0, $"<div style='padding-left:{depth*16+16}px' class='file' @onclick='{() => SelectFile(path)}'>{icon} {f.Name}</div>");
        }
    };

    private async Task SelectFile(string path)
    {
        _selectedFile = path;
        _fileContent = "";
        _analysisResult = null;
        try
        {
            _fileContent = File.ReadAllText(path);
            var lang = LanguageRegistry.Detect(path);
            _analysisResult = await Analyzer.AnalyzeAsync(_fileContent[..Math.Min(_fileContent.Length, 5000)], lang);
        }
        catch { _fileContent = "Cannot read file."; }
        StateHasChanged();
    }
}
