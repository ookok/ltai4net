<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LTAI.AI</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <!-- P17.3: 本地缓存增强 �?支持 LTAI_EMBEDDING_MODELS_DIR 环境变量
       指向预下载的模型目录（CI / 共享缓存 / 离线环境）�?
       未设置时回退�?repo-root/models/（与 P13.6 单文件原则一致）�?-->
  <PropertyGroup>
    <_LTAI_ModelsDir>$([System.Environment]::GetEnvironmentVariable('LTAI_EMBEDDING_MODELS_DIR'))</_LTAI_ModelsDir>
    <ModelsDir Condition="'$(_LTAI_ModelsDir)' != ''">$(_LTAI_ModelsDir)</ModelsDir>
    <ModelsDir Condition="'$(ModelsDir)' == ''">$(MSBuildThisFileDirectory)../../models/</ModelsDir>
    <ModelsDir Condition="!HasTrailingSlash('$(ModelsDir)')">$(ModelsDir)\</ModelsDir>
    <_ModelsDirLabel Condition="'$(_LTAI_ModelsDir)' != ''">overridden by LTAI_EMBEDDING_MODELS_DIR</_ModelsDirLabel>
    <_ModelsDirLabel Condition="'$(_ModelsDirLabel)' == ''">default (repo-root/models/)</_ModelsDirLabel>
    <ToolsDir Condition="'$(ToolsDir)' == ''">$(MSBuildThisFileDirectory)../../tools/</ToolsDir>
    <ToolsDir Condition="!HasTrailingSlash('$(ToolsDir)')">$(ToolsDir)\</ToolsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="System.ClientModel" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
    <!-- P13.2: optional CUDA + TensorRT EPs. If the user has no NVIDIA GPU
         these DLLs are never loaded �?TryAppendCuda catches the
         TypeLoadException. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" />
    <Reference Include="Microsoft.Agents.AI.Abstractions" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Abstractions.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Abstractions.dll')" />
    <Reference Include="Microsoft.Agents.AI" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.dll')" />
    <Reference Include="Microsoft.Agents.AI.OpenAI" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.OpenAI.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.OpenAI.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI\Microsoft.Agents.AI.csproj" Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.OpenAI\Microsoft.Agents.AI.OpenAI.csproj" Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.OpenAI.dll')" />
    <Reference Include="Microsoft.Agents.AI.Anthropic" HintPath="..\..\dist\lib\maf\Microsoft.Agents.AI.Anthropic.dll" Condition="Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Anthropic.dll')" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.Anthropic\Microsoft.Agents.AI.Anthropic.csproj" Condition="!Exists('..\..\dist\lib\maf\Microsoft.Agents.AI.Anthropic.dll')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LTAI.Core\LTAI.Core.csproj" />
  </ItemGroup>

  <!-- P14.1: MiniLM only, Xenova 通用 INT8 (22MB) �?仅首次构建时下载�?
       模型目录�?$(ModelsDir) 控制（默�?repo-root/models/）�?
       文件存在时完全跳�?—�?不再每次构建都检查�?-->
  <Target Name="DownloadEmbeddingModelMiniLM" BeforeTargets="Build" Condition="!Exists('$(ModelsDir)minilm-l6-v2/model.int8.onnx')">
    <Message Text="DownloadEmbeddingModelMiniLM: downloading Xenova INT8 to $(ModelsDir)minilm-l6-v2/" Importance="High" />
    <MakeDir Directories="$(ModelsDir)minilm-l6-v2/" />
    <Exec Command="curl -sL --connect-timeout 10 --max-time 300 &quot;https://hf-mirror.com/Xenova/all-MiniLM-L6-v2/resolve/main/onnx/model_int8.onnx&quot; -o &quot;$(ModelsDir)minilm-l6-v2/model.int8.onnx&quot;" IgnoreExitCode="true" />
    <Exec Command="curl -sL --connect-timeout 10 --max-time 60 &quot;https://hf-mirror.com/Xenova/all-MiniLM-L6-v2/resolve/main/vocab.txt&quot; -o &quot;$(ModelsDir)minilm-l6-v2/vocab.txt&quot;" IgnoreExitCode="true" />
    <Message Text="all-MiniLM-L6-v2 Xenova INT8 downloaded �?models/minilm-l6-v2/model.int8.onnx (~22MB)" Importance="High" />
  </Target>

  <!-- 发布时嵌入模型文件到输出目录 (按现有文件复�? 不强行补�? -->
  <Target Name="PublishEmbeddingModel" AfterTargets="Publish" Condition="Exists('$(ModelsDir)minilm-l6-v2/model.int8.onnx')">
    <Message Text="PublishEmbeddingModel: ModelsDir=$(ModelsDir) ($(_ModelsDirLabel))" Importance="High" />
    <Copy SourceFiles="$(ModelsDir)minilm-l6-v2/model.int8.onnx" DestinationFolder="$(PublishDir)models/minilm-l6-v2/" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ModelsDir)minilm-l6-v2/vocab.txt" DestinationFolder="$(PublishDir)models/minilm-l6-v2/" SkipUnchangedFiles="true" />
    <Message Text="MiniLM INT8 embedded in publish output �?(22MB)" Importance="High" />
  </Target>

  <!-- rg.exe (ripgrep) �?自动下载�?tools/rg/，仅�?Windows x64.
       搜索工具优先使用 rg，无 rg 时回退 C# 内置实现�?-->
  <Target Name="DownloadRipgrep" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows')) And !Exists('$(ToolsDir)rg\rg.exe')">
    <Message Text="DownloadRipgrep: downloading rg.exe to $(ToolsDir)rg/" Importance="High" />
    <MakeDir Directories="$(ToolsDir)rg/" />
    <Exec Command="powershell -NoProfile -Command &quot;$wc=New-Object Net.WebClient; $wc.Headers.Add('User-Agent','LTAI/1.0'); $wc.DownloadFile('https://github.com/BurntSushi/ripgrep/releases/download/14.1.1/rg.exe','$(ToolsDir)rg\rg.exe'); if (Test-Path '$(ToolsDir)rg\rg.exe') { Write-Host 'rg.exe downloaded' } else { Write-Host 'download failed'; exit 1 }&quot;" IgnoreExitCode="true" />
  </Target>

</Project>
