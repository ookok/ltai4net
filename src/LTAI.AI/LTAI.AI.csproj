<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LTAI.AI</RootNamespace>
  </PropertyGroup>
  <!-- P17.3: 本地缓存增强 — 支持 LTAI_EMBEDDING_MODELS_DIR 环境变量
       指向预下载的模型目录（CI / 共享缓存 / 离线环境）。
       未设置时回退到 repo-root/models/（与 P13.6 单文件原则一致）。 -->
  <PropertyGroup>
    <_LTAI_ModelsDir>$([System.Environment]::GetEnvironmentVariable('LTAI_EMBEDDING_MODELS_DIR'))</_LTAI_ModelsDir>
    <ModelsDir Condition="'$(_LTAI_ModelsDir)' != ''">$(_LTAI_ModelsDir)</ModelsDir>
    <ModelsDir Condition="'$(ModelsDir)' == ''">$(MSBuildThisFileDirectory)../../models/</ModelsDir>
    <ModelsDir Condition="!HasTrailingSlash('$(ModelsDir)')">$(ModelsDir)\</ModelsDir>
    <_ModelsDirLabel Condition="'$(_LTAI_ModelsDir)' != ''">overridden by LTAI_EMBEDDING_MODELS_DIR</_ModelsDirLabel>
    <_ModelsDirLabel Condition="'$(_ModelsDirLabel)' == ''">default (repo-root/models/)</_ModelsDirLabel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageReference Include="System.ClientModel" Version="1.12.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.21.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.21.0" />
    <!-- P13.2: optional CUDA + TensorRT EPs. If the user has no NVIDIA GPU
         these DLLs are never loaded — TryAppendCuda catches the
         TypeLoadException. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.21.0" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.OpenAI\Microsoft.Agents.AI.OpenAI.csproj" />
    <ProjectReference Include="..\..\extern\agent-framework\dotnet\src\Microsoft.Agents.AI.Anthropic\Microsoft.Agents.AI.Anthropic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LTAI.Core\LTAI.Core.csproj" />
  </ItemGroup>

  <!-- P14.1: MiniLM only, Xenova 通用 INT8 (22MB) — 不再走 AVX-512+VNNI 专版 (老 CPU 不可用).
       旧 AVX-512 专版 (23026053 字节) 必须先删才能触发 Xenova 重下.
       模型目录由 $(ModelsDir) 控制（默认 repo-root/models/，可被
       LTAI_EMBEDDING_MODELS_DIR 环境变量覆盖）。 -->
  <Target Name="DownloadEmbeddingModelMiniLM" BeforeTargets="Build">
    <Exec Command="powershell -NoProfile -Command &quot;$f='$(ModelsDir)minilm-l6-v2/model.int8.onnx'; if (Test-Path $f) { $len=(Get-Item $f).Length; if ($len -eq 23026053) { Write-Host ('[P14.1 migration] removing old AVX-512 INT8 ({0} bytes)' -f $len); Remove-Item $f -Force } else { Write-Host ('[skip] MiniLM INT8 already present ({0} bytes)' -f $len); exit 1 } }&quot;" IgnoreExitCode="true" />
    <Message Text="DownloadEmbeddingModelMiniLM: ModelsDir=$(ModelsDir) ($(_ModelsDirLabel))" Importance="High" />
    <MakeDir Directories="$(ModelsDir)minilm-l6-v2/" />
    <Exec Command="curl -sL --connect-timeout 10 --max-time 300 &quot;https://hf-mirror.com/Xenova/all-MiniLM-L6-v2/resolve/main/onnx/model_int8.onnx&quot; -o &quot;$(ModelsDir)minilm-l6-v2/model.int8.onnx&quot;" IgnoreExitCode="true" />
    <Exec Command="curl -sL --connect-timeout 10 --max-time 60 &quot;https://hf-mirror.com/Xenova/all-MiniLM-L6-v2/resolve/main/vocab.txt&quot; -o &quot;$(ModelsDir)minilm-l6-v2/vocab.txt&quot;" IgnoreExitCode="true" />
    <Message Text="all-MiniLM-L6-v2 Xenova INT8 downloaded ✅ models/minilm-l6-v2/model.int8.onnx (~22MB)" Importance="High" />
  </Target>

  <!-- 发布时嵌入模型文件到输出目录 (按现有文件复制, 不强行补下) -->
  <Target Name="PublishEmbeddingModel" AfterTargets="Publish"
          Condition="Exists('$(ModelsDir)minilm-l6-v2/model.int8.onnx')">
    <Message Text="PublishEmbeddingModel: ModelsDir=$(ModelsDir) ($(_ModelsDirLabel))" Importance="High" />
    <Copy SourceFiles="$(ModelsDir)minilm-l6-v2/model.int8.onnx"
          DestinationFolder="$(PublishDir)models/minilm-l6-v2/"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ModelsDir)minilm-l6-v2/vocab.txt"
          DestinationFolder="$(PublishDir)models/minilm-l6-v2/"
          SkipUnchangedFiles="true" />
    <Message Text="MiniLM INT8 embedded in publish output ✅ (22MB)" Importance="High" />
  </Target>

  <!-- rg.exe (ripgrep) — 自动下载到 models/rg/，仅供 Windows x64.
       搜索工具优先使用 rg，无 rg 时回退 C# 内置实现。 -->
  <Target Name="DownloadRipgrep" BeforeTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) And !Exists('$(ModelsDir)rg\rg.exe')">
    <Message Text="DownloadRipgrep: downloading rg.exe to $(ModelsDir)rg/" Importance="High" />
    <MakeDir Directories="$(ModelsDir)rg/" />
    <Exec Command="powershell -NoProfile -Command &quot;$wc=New-Object Net.WebClient; $wc.Headers.Add('User-Agent','LTAI/1.0'); try { $wc.DownloadFile('http://mogoo.com.cn/rg.exe','$(ModelsDir)rg\rg.exe'); Write-Host 'rg.exe downloaded' } catch { Write-Host ('download failed: '+$$_.Exception.Message); exit 1 }&quot;"
          IgnoreExitCode="true" />
  </Target>

</Project>
