<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>LTAI.Desktop</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>LTAI Desktop</ApplicationTitle>
    <ApplicationId>com.ltai.desktop</ApplicationId>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <ApplicationDisplayVersion>6.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\appicon.svg" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Update="Microsoft.Playwright" Action="Remove" />
    <TrimmerRootAssembly Update="Docker.DotNet" Action="Remove" />
    <TrimmerRootAssembly Update="Tesseract" Action="Remove" />
    <TrimmerRootAssembly Update="LLamaSharp" Action="Remove" />
    <TrimmerRootAssembly Update="LLamaSharp.Backend.Cpu" Action="Remove" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LTAI.Core\LTAI.Core.csproj" />
    <ProjectReference Include="..\LTAI.AI\LTAI.AI.csproj" />
    <ProjectReference Include="..\LTAI.DNA\LTAI.DNA.csproj" />
    <ProjectReference Include="..\LTAI.Tools\LTAI.Tools.csproj" />
    <ProjectReference Include="..\LTAI.Knowledge\LTAI.Knowledge.csproj" />
    <ProjectReference Include="..\LTAI.Planning\LTAI.Planning.csproj" />
    <ProjectReference Include="..\LTAI.Agent\LTAI.Agent.csproj" />
  </ItemGroup>

</Project>
