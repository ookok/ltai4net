<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationDisplayVersion>0.51.0</ApplicationDisplayVersion>
    <ApplicationIcon>Assets\ltai-icon.ico</ApplicationIcon>
    <IsExeProject>true</IsExeProject>
    <RootNamespace>LTAI.Desktop</RootNamespace>
    <AssemblyName>LTAI.Desktop</AssemblyName>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.5" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.5" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LTAI.Core\LTAI.Core.csproj" />
    <ProjectReference Include="..\LTAI.Agent\LTAI.Agent.csproj" />
    <ProjectReference Include="..\LTAI.AI\LTAI.AI.csproj" />
    <ProjectReference Include="..\LTAI.DNA\LTAI.DNA.csproj" />
    <ProjectReference Include="..\LTAI.Planning\LTAI.Planning.csproj" />
    <ProjectReference Include="..\LTAI.Knowledge\LTAI.Knowledge.csproj" />
  </ItemGroup>
</Project>
