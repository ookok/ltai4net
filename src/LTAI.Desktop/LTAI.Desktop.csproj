<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsExeProject>true</IsExeProject>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\dist\Desktop\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>LTAI.Desktop</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>LTAI Desktop</ApplicationTitle>
    <ApplicationId>com.ltai.desktop</ApplicationId>
    <ApplicationDisplayVersion>6.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.*" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.*" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\appicon.svg" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LTAI.Core\LTAI.Core.csproj" />
    <ProjectReference Include="..\LTAI.AI\LTAI.AI.csproj" />
    <ProjectReference Include="..\LTAI.DNA\LTAI.DNA.csproj" />
    <ProjectReference Include="..\LTAI.Tools\LTAI.Tools.csproj" />
    <ProjectReference Include="..\LTAI.Knowledge\LTAI.Knowledge.csproj" />
    <ProjectReference Include="..\LTAI.Planning\LTAI.Planning.csproj" />
    <ProjectReference Include="..\LTAI.Agent\LTAI.Agent.csproj" />
  </ItemGroup>

</Project>
