<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:LTAI.Desktop.Pages"
       x:Class="LTAI.Desktop.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.TabBarBackgroundColor="#161b22"
       Shell.TabBarForegroundColor="#8b949e"
       Shell.TabBarUnselectedColor="#484f58"
       Shell.TabBarTitleColor="#58a6ff">

    <TabBar>
        <ShellContent Title="Dashboard" Icon="dashboard.png" ContentTemplate="{DataTemplate pages:DashboardPage}" />
        <ShellContent Title="Chat" Icon="chat.png" ContentTemplate="{DataTemplate pages:ChatPage}" />
        <ShellContent Title="Files" Icon="files.png" ContentTemplate="{DataTemplate pages:FilesPage}" />
        <ShellContent Title="Settings" Icon="settings.png" ContentTemplate="{DataTemplate pages:SettingsPage}" />
    </TabBar>
</Shell>
