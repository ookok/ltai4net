<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LTAI.Desktop.Pages.DashboardPage"
             BackgroundColor="#0d1117"
             Title="Dashboard">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Dashboard" FontSize="24" TextColor="#f0f6fc" FontAttributes="Bold" />
            
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <!-- DNA Status Card -->
                <Frame Grid.Column="0" BackgroundColor="#161b22" BorderColor="#30363d" CornerRadius="8" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="DNA STATUS" FontSize="11" TextColor="#8b949e" />
                        <Label x:Name="ConsciousnessLabel" Text="--" FontSize="14" TextColor="#58a6ff" />
                        <Label x:Name="EvolutionLabel" Text="--" TextColor="#3fb950" />
                        <Label x:Name="SafetyLabel" Text="--" TextColor="#f85149" />
                        <Label x:Name="BiorhythmLabel" Text="--" TextColor="#d29922" />
                    </VerticalStackLayout>
                </Frame>

                <!-- System Card -->
                <Frame Grid.Column="1" BackgroundColor="#161b22" BorderColor="#30363d" CornerRadius="8" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="SYSTEM" FontSize="11" TextColor="#8b949e" />
                        <Label x:Name="ModeLabel" Text="Mode: --" TextColor="#c9d1d9" />
                        <Label x:Name="RequestsLabel" Text="Req: --" TextColor="#c9d1d9" />
                        <Label x:Name="TokensLabel" Text="Tokens: --" TextColor="#c9d1d9" />
                        <Label x:Name="LatencyLabel" Text="Latency: --" TextColor="#c9d1d9" />
                        <Label x:Name="MemoryLabel" Text="MEM: --" TextColor="#c9d1d9" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Hormones Card -->
                <Frame Grid.Column="2" BackgroundColor="#161b22" BorderColor="#30363d" CornerRadius="8" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="HORMONES" FontSize="11" TextColor="#8b949e" />
                        <Label x:Name="DopamineLabel" Text="--" TextColor="#bc8cff" />
                        <Label x:Name="SerotoninLabel" Text="--" TextColor="#d29922" />
                        <Label x:Name="CortisolLabel" Text="--" TextColor="#f85149" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Personality Card -->
            <Frame BackgroundColor="#161b22" BorderColor="#30363d" CornerRadius="8" Padding="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="PERSONALITY" FontSize="11" TextColor="#8b949e" />
                    <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0"><Label x:Name="OLabel" Text="O:--" FontSize="12" TextColor="#58a6ff" /><ProgressBar x:Name="OBar" ProgressColor="#58a6ff" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1"><Label x:Name="CLabel" Text="C:--" FontSize="12" TextColor="#3fb950" /><ProgressBar x:Name="CBar" ProgressColor="#3fb950" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2"><Label x:Name="ELabel" Text="E:--" FontSize="12" TextColor="#d29922" /><ProgressBar x:Name="EBar" ProgressColor="#d29922" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3"><Label x:Name="ALabel" Text="A:--" FontSize="12" TextColor="#79c0ff" /><ProgressBar x:Name="ABar" ProgressColor="#79c0ff" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="4"><Label x:Name="NLabel" Text="N:--" FontSize="12" TextColor="#f85149" /><ProgressBar x:Name="NBar" ProgressColor="#f85149" /></VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Genes Card -->
            <Frame BackgroundColor="#161b22" BorderColor="#30363d" CornerRadius="8" Padding="12">
                <VerticalStackLayout x:Name="GenesStack" Spacing="4">
                    <Label Text="GENES" FontSize="11" TextColor="#8b949e" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
