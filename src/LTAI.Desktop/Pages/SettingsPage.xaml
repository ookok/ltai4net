<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LTAI.Desktop.Pages.SettingsPage"
             BackgroundColor="#0d1117"
             Title="Diagnostics">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label x:Name="VersionLabel" FontSize="24" TextColor="#f0f6fc" FontAttributes="Bold" />
            <BoxView HeightRequest="1" Color="#30363d" />
            <Label x:Name="DnaLabel" FontSize="13" TextColor="#8b949e" />
            <Label x:Name="SafetyLabel" FontSize="13" TextColor="#8b949e" />
            <Label x:Name="RouterLabel" FontSize="13" TextColor="#8b949e" />
            <Label x:Name="SystemLabel" FontSize="13" TextColor="#8b949e" />
            <BoxView HeightRequest="1" Color="#30363d" />
            <Label x:Name="ProviderLabel" FontSize="12" TextColor="#484f58" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
