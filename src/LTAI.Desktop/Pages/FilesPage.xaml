<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LTAI.Desktop.Pages.FilesPage"
             BackgroundColor="#0d1117"
             Title="Files">
    <Grid ColumnDefinitions="250,*" Padding="16" ColumnSpacing="12">
        <Frame Grid.Column="0" BackgroundColor="#161b22" BorderColor="#30363d" CornerRadius="8" Padding="8">
            <ScrollView>
                <VerticalStackLayout x:Name="TreeStack" Spacing="2" />
            </ScrollView>
        </Frame>

        <Frame Grid.Column="1" BackgroundColor="#161b22" BorderColor="#30363d" CornerRadius="8" Padding="12">
            <VerticalStackLayout>
                <Label x:Name="FileTitle" Text="Select a file" FontSize="16" TextColor="#f0f6fc" />
                <Label x:Name="FileInfo" Text="" FontSize="11" TextColor="#8b949e" Margin="0,4,0,8" />
                <ScrollView Orientation="Both">
                    <Label x:Name="FileContent" Text="" FontSize="12" TextColor="#c9d1d9" FontFamily="Consolas" />
                </ScrollView>
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>
