<Directives>
  <Application>
    <!-- ===== NativeAOT linker roots ===== -->
    <!-- Preserve DI-resolved types needed for MAF agent runtime and JSON serialization -->

    <!-- MAF agent framework reflection roots -->
    <Assembly Name="Microsoft.Agents.AI" Dynamic="Required All" />
    <Assembly Name="Microsoft.Agents.AI.Abstractions" Dynamic="Required All" />

    <!-- ONNX Runtime -->
    <Assembly Name="Microsoft.ML.OnnxRuntime" Dynamic="Required All" />

    <!-- SQLite -->
    <Assembly Name="Microsoft.Data.Sqlite" Dynamic="Required All" />

    <!-- ===== LTAI assemblies — full preservation for DI + tool reflection ===== -->
    <Assembly Name="LTAI.Core" Dynamic="Required All" Serialize="Required All" />
    <Assembly Name="LTAI.AI" Dynamic="Required All" Serialize="Required All" />
    <Assembly Name="LTAI.Agent" Dynamic="Required All" Serialize="Required All" />
    <Assembly Name="LTAI.Cli" Dynamic="Required All" />
    <Assembly Name="LTAI.Web" Dynamic="Required All" />

    <!-- ===== Known reflection targets ===== -->
    <!-- AIFunctionFactory.Create() wraps methods via reflection -->
    <Type Name="LTAI.Agent.Tools.*" Dynamic="Required All" />
    <Type Name="LTAI.Agent.Vector.*" Dynamic="Required All" />

    <!-- ToolDomain/ToolExample attribute scanning -->
    <Type Name="LTAI.AI.ToolDomainAttribute" Dynamic="Required All" />
    <Type Name="LTAI.AI.ToolExampleAttribute" Dynamic="Required All" />

    <!-- KG store data types (JSON serialization via reflection) -->
    <Type Name="LTAI.Agent.Vector.NodeRow" Dynamic="Required All" Serialize="Required All" />
    <Type Name="LTAI.Agent.Vector.EdgeRow" Dynamic="Required All" Serialize="Required All" />
    <Type Name="LTAI.Agent.Vector.DocRow" Dynamic="Required All" Serialize="Required All" />

    <!-- Chat agent types -->
    <Type Name="LTAI.Agent.Agents.ChatAgent" Dynamic="Required All" />

    <!-- DI registrations -->
    <Type Name="LTAI.Agent.ServiceCollectionExtensions" Dynamic="Required All" />
    <Type Name="LTAI.Agent.Agents.AgentBuilder" Dynamic="Required All" />

    <!-- Workflow types -->
    <Type Name="LTAI.Agent.Workflows.AgentWorkflows" Dynamic="Required All" />
    <Type Name="LTAI.Agent.Workflows.DecisionTreeRouter" Dynamic="Required All" />
    <Type Name="LTAI.Agent.Workflows.YAMLWorkflowRegistry" Dynamic="Required All" />

    <!-- Config types -->
    <Type Name="LTAI.Core.Configuration.LTAIOptions" Dynamic="Required All" Serialize="Required All" />

    <!-- Session/persistence types -->
    <Type Name="LTAI.Core.Session.SessionMeta" Dynamic="Required All" Serialize="Required All" />
  </Application>
</Directives>
